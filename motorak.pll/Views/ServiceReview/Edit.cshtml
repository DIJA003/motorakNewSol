@using Motorak.BLL.ModelVM.ServiceReview
@model UpdateServiceReviewVM

@{
    ViewBag.Title = "Edit Service Review";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container py-5">
    <div class="card shadow-lg">
        <div class="card-header bg-warning text-dark">
            <h4><i class="bi bi-pencil"></i> Edit Service Review</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ReviewId" />

                <div class="mb-3">
                    <label class="form-label">Rating</label>
                    <div id="starRating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.Rating)
                            {
                                <i class="bi bi-star-fill text-warning fs-4" data-value="@i" style="cursor:pointer;"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-warning fs-4" data-value="@i" style="cursor:pointer;"></i>
                            }
                        }
                    </div>
                    <input type="hidden" asp-for="Rating" id="ratingValue" />
                </div>

                <div class="mb-3">
                    <label asp-for="Comments" class="form-label"></label>
                    <textarea asp-for="Comments" class="form-control"></textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>

                @* <div class="mb-3">
                    <label asp-for="ServiceId" class="form-label"></label>
                    <input asp-for="ServiceId" class="form-control" />
                    <span asp-validation-for="ServiceId" class="text-danger"></span>
                </div> *@

                @* <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label"></label>
                    <input asp-for="CustomerId" class="form-control" />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div> *@

                @* <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Completed" @(Model.Status == "Completed" ? "selected" : "")>Completed</option>
                        <option value="Cancelled" @(Model.Status == "Cancelled" ? "selected" : "")>Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div> *@

                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const stars = document.querySelectorAll('#starRating i');
        const ratingValue = document.getElementById('ratingValue');

        stars.forEach(star => {
            star.addEventListener('click', () => {
                const val = star.getAttribute('data-value');
                ratingValue.value = val;
                stars.forEach(s => {
                    s.classList.remove('bi-star-fill');
                    s.classList.add('bi-star');
                });
                for (let i = 0; i < val; i++) {
                    stars[i].classList.remove('bi-star');
                    stars[i].classList.add('bi-star-fill');
                }
            });
        });

        // Set initial star rating on page load
        window.onload = function () {
            let initialRating = parseInt(ratingValue.value);
            stars.forEach((star, idx) => {
                if (idx < initialRating) {
                    star.classList.remove('bi-star');
                    star.classList.add('bi-star-fill');
                }
                else {
                    star.classList.remove('bi-star-fill');
                    star.classList.add('bi-star');
                }
            });
        }
    </script>
}
