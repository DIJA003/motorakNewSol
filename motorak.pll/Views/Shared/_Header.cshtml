@using Motorak.BLL.Helper
@inject IHttpContextAccessor HttpContextAccessor

<header class="header" id="header">
    <nav class="nav container">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__logo">
            <i class="ri-steering-fill"></i>
            @SharedLocalizer["Motorak"]
        </a>
        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                @if (User.IsInRole("Admin"))
                {
                    <!-- Admin Navigation -->
                    <li class="nav__item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__link">
                            <i class="ri-home-line"></i> Home
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Car" asp-action="Index" class="nav__link">
                            <i class="ri-car-fill"></i> Cars
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Customer" asp-action="Index" class="nav__link">
                            <i class="ri-user-3-line"></i> Customers
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Mechanic" asp-action="Index" class="nav__link">
                            <i class="ri-tools-fill"></i> Mechanics
                        </a>
                    </li>
                    <li class="nav__item">
                        <a href="/hangfire" class="nav__link" target="_blank">
                            <i class="ri-dashboard-3-line"></i> Hangfire
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Service" asp-action="Index" class="nav__link">
                            <i class="ri-service-fill"></i> Services
                        </a>
                    </li>
                }
                else if (User.IsInRole("Mechanic"))
                {
                    <!-- Mechanic Navigation -->
                    <li class="nav__item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__link">
                            <i class="ri-home-line"></i> Home
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Service" asp-action="Index" class="nav__link">
                            <i class="ri-service-fill"></i> Services
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Car" asp-action="Index" class="nav__link">
                            <i class="ri-car-fill"></i> Cars
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Mechanic" asp-action="Dashboard" class="nav__link">
                            <i class="ri-dashboard-line"></i> My Dashboard
                        </a>
                    </li>
                }
                else if (User.IsInRole("Customer") || User.Identity.IsAuthenticated)
                {
                    <!-- Customer Navigation -->
                    <li class="nav__item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__link">
                            <i class="ri-home-line"></i> Home
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Car" asp-action="Index" class="nav__link">
                            <i class="ri-car-fill"></i> Cars
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Service" asp-action="Index" class="nav__link">
                            <i class="ri-service-fill"></i> Services
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Cart" asp-action="Index" class="nav__link">
                            <i class="ri-shopping-cart-line"></i> 
                            Cart 
                            <span class="cart-badge" id="cart-count">
                                @((HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<Motorak.DAL.Entites.CartItem>>("Cart")?.Sum(c => c.Count) ?? 0))
                            </span>
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Customer" asp-action="Dashboard" class="nav__link">
                            <i class="ri-user-line"></i> My Account
                        </a>
                    </li>
                }
                else
                {
                    <!-- Guest/Unauthenticated Navigation -->
                    <li class="nav__item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__link">
                            <i class="ri-home-line"></i> Home
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Car" asp-action="Index" class="nav__link">
                            <i class="ri-car-fill"></i> Cars
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Service" asp-action="Index" class="nav__link">
                            <i class="ri-service-fill"></i> Services
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Home" asp-action="About" class="nav__link">
                            <i class="ri-information-line"></i> About
                        </a>
                    </li>
                    <li class="nav__item">
                        <a asp-controller="Home" asp-action="Contact" class="nav__link">
                            <i class="ri-phone-line"></i> Contact
                        </a>
                    </li>
                }
            </ul>

            <!-- Authentication Partial View -->
            <partial name="_LoginPartial" />

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>
    </nav>
</header>

<style>
    /* Enhanced Navigation Styles */
    .nav__link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .nav__link:hover {
        background: rgba(var(--first-color-rgb), 0.1);
        color: var(--first-color);
        transform: translateY(-2px);
    }

    /* Cart Badge Styling */
    .cart-badge {
        background: var(--first-color);
        color: var(--white-color);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        border-radius: 50px;
        min-width: 1.5rem;
        text-align: center;
        margin-left: 0.25rem;
        animation: pulse 2s infinite;
    }

    .cart-badge:empty {
        display: none;
    }

    /* Role-specific styling */
    .nav__list {
        gap: 0.5rem;
    }

    /* Admin specific styles */
    body:has(.nav__link[href*="hangfire"]) .nav__link[href*="hangfire"] {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        color: var(--white-color);
        border-radius: 0.5rem;
    }

    body:has(.nav__link[href*="hangfire"]) .nav__link[href*="hangfire"]:hover {
        background: linear-gradient(135deg, #7c3aed, #6d28d9);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    /* Mechanic Dashboard styling */
    .nav__link[href*="Dashboard"] {
        background: rgba(var(--first-color-rgb), 0.1);
        border: 1px solid rgba(var(--first-color-rgb), 0.2);
    }

    .nav__link[href*="Dashboard"]:hover {
        background: var(--first-color);
        color: var(--white-color);
    }

    /* Customer Account styling */
    .nav__link[href*="Account"] {
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .nav__link[href*="Account"]:hover {
        background: #16a34a;
        color: var(--white-color);
    }

    /* Active link styling */
    .nav__link.active {
        background: var(--first-color);
        color: var(--white-color);
        font-weight: 600;
    }

    .nav__link.active::after {
        content: '';
        position: absolute;
        bottom: -0.5rem;
        left: 50%;
        transform: translateX(-50%);
        width: 0.5rem;
        height: 0.5rem;
        background: var(--first-color);
        border-radius: 50%;
    }


    /* Role indicator badges */
    .nav__logo::after {
        content: '';
        position: absolute;
        top: -0.5rem;
        right: -0.5rem;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        display: none;
    }

    /* Show role indicator for logged-in users */
    </style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Add active class to current page link
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('.nav__link');
        
        navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href && currentPath.includes(href) && href !== '/') {
                link.classList.add('active');
            } else if (href === '/' && currentPath === '/') {
                link.classList.add('active');
            }
        });

        // Update cart count dynamically (if you have AJAX cart functionality)
        function updateCartCount() {
            fetch('/Cart/GetCartCount')
                .then(response => response.json())
                .then(data => {
                    const cartBadge = document.getElementById('cart-count');
                    if (cartBadge) {
                        cartBadge.textContent = data.count || '';
                        if (data.count > 0) {
                            cartBadge.style.display = 'inline-block';
                        } else {
                            cartBadge.style.display = 'none';
                        }
                    }
                })
                .catch(error => console.log('Cart count update failed:', error));
        }

        // Update cart count every 30 seconds for active users
        @if (User.Identity.IsAuthenticated)
        {
            <text>
            setInterval(updateCartCount, 30000);
            </text>
        }

        // Add smooth scrolling for anchor links
        navLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href && href.startsWith('#')) {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                }
            });
        });

        // Mobile menu auto-close on link click
        const navClose = document.getElementById('nav-close');
        const navMenu = document.getElementById('nav-menu');
        
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth <= 767) {
                    navMenu.classList.remove('show-menu');
                }
            });
        });
    });
</script>