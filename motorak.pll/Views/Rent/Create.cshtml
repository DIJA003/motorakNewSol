@using Motorak.BLL.ModelVM.Rents
@model RentCreateDto

@{
    ViewData["Title"] = "Create Rent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">🚗 Create New Rent</h2>

    <div class="card shadow rounded">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="StartDate" class="form-label fw-bold">
                        <i class="bi bi-calendar-check"></i> Start Date
                    </label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                    <small class="form-text text-muted">Select the rental start date</small>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDate" class="form-label fw-bold">
                        <i class="bi bi-calendar-x"></i> End Date
                    </label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                    <small class="form-text text-muted">Select the rental return date</small>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label fw-bold">
                        <i class="bi bi-credit-card"></i> Payment Method
                    </label>
                    <select asp-for="PaymentMethod" class="form-control">
                        <option value="">-- Select Payment Method --</option>
                        <option value="Credit Card">Credit Card</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Cash">Cash</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                    </select>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    <small class="form-text text-muted">Choose your preferred payment method</small>
                </div>

                <div class="mb-3">
                    <label asp-for="CarId" class="form-label fw-bold">
                        <i class="bi bi-car-front"></i> Car ID
                    </label>
                    <input asp-for="CarId" class="form-control" type="number" readonly />
                    <span asp-validation-for="CarId" class="text-danger"></span>
                    <small class="form-text text-muted">Vehicle identification number (auto-filled)</small>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalPrice" class="form-label fw-bold">
                        <i class="bi bi-calculator"></i> Total Price
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="TotalPrice" class="form-control" type="number" step="0.01" readonly />
                    </div>
                    <span asp-validation-for="TotalPrice" class="text-danger"></span>
                    <small class="form-text text-muted">Total rental cost (auto-calculated)</small>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label fw-bold">
                        <i class="bi bi-person"></i> Customer ID
                    </label>
                    <input asp-for="CustomerId" class="form-control" type="number" placeholder="Enter Customer ID" />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                    <small class="form-text text-muted">Enter the customer's ID number</small>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Save Rent
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}