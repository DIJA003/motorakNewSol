@model List<Motorak.DAL.Entites.CartItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Your Cart</h2>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                
                <th>Brand</th>
                <th>Model</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    
                    <td>@item.Brand</td>
                    <td>@item.Model</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@((item.Quantity* item.Price).ToString("C"))</td>
                    
                </tr>
            }
        </tbody>
    </table>
}
