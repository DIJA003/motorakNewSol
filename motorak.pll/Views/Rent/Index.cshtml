@using Motorak.BLL.ModelVM.Rents
@model IEnumerable<RentReadDto>

@{
    ViewData["Title"] = "Rents List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">📄 Rents List</h2>

    <p>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Rent
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Payment Method</th>
                    <th>Total Price</th>
                    <th>Status</th>
                    <th>Customer ID</th>
                    <th>Car ID</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rent in Model)
                {
                    <tr>
                        <td>@rent.StartDate.ToShortDateString()</td>
                        <td>@rent.EndDate.ToShortDateString()</td>
                        <td>@rent.PaymentMethod</td>
                        <td>$@rent.TotalPrice.ToString("N2")</td>
                        <td>
                            <span class="badge @(rent.Status == Motorak.DAL.Enums.TransactionEnums.TransactionStatus.Completed ? "bg-success" :
                                                                                 rent.Status == Motorak.DAL.Enums.TransactionEnums.TransactionStatus.Cancelled ? "bg-danger" : "bg-warning")">
                            @rent.Status
                        </span>
                    </td>
                    <td>@rent.CustomerId</td>
                    <td>@rent.CarId</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@rent.Id" class="btn btn-info btn-sm" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@rent.Id" class="btn btn-warning btn-sm" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@rent.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this rent?');">
                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}