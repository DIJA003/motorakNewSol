@model List<Motorak.BLL.ModelVM.Car.CarListModel>
@using Motorak.DAL.Enums.CarEnums
@using motorak.dal.Enums.CarEnums

@{
    ViewData["Title"] = "Available Cars";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Available Cars</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
            <th>Daily Rent Price</th>
            <th>Mileage</th>
            <th>Status</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var car in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(car.ImagePath))
                        {
                            <img src="@Url.Content(car.ImagePath)" alt="@($"{car.Brand} {car.Model}")" width="120" height="80" style="object-fit:cover;" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>
                    <td>@car.Brand</td>
                    <td>@car.Model</td>
                    <td>@car.Year</td>
                    <td>
                        @(car.Category == CarCategory.ForSale ? car.Price.ToString("C") : "-")
                    </td>
                    <td>
                        @(car.Category == CarCategory.ForRent && car.DailyRentPrice.HasValue ? car.DailyRentPrice.Value.ToString("C") : "-")
                    </td>
                    <td>@car.Mileage.ToString("N0") km</td>
                    <td>@car.Status</td>
                    <td>@car.Category</td>
                    <td>
                        <!-- Add to Cart button (always available) -->
                        <button type="button" class="btn btn-sm btn-warning mb-1 add-to-cart" data-id="@car.Id">Add to Cart</button>

                        <!-- Buy button -->
                        @if (car.Category == CarCategory.ForSale)
                        {
                            <a asp-controller="Purchase" asp-action="Create" asp-route-carId="@car.Id" class="btn btn-sm btn-success mb-1">Buy</a>
                        }

                        <!-- Rent button -->
                        @if (car.Category == CarCategory.ForRent)
                        {
                            <a asp-controller="Rent" asp-action="Create" asp-route-carId="@car.Id" class="btn btn-sm btn-primary">Rent</a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">No cars available.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).on("click", ".add-to-cart", function () {
            var id = $(this).data("id");
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    $("#cart-count").text(res.count);
                    alert("Added to cart!");
                },
                error: function () {
                    alert("Failed to add to cart.");
                }
            });
        });
    </script>
}
