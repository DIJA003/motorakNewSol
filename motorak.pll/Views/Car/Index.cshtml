@using Microsoft.AspNetCore.Identity
@using Motorak.DAL.Entites
@using motorak.dal.Entites
@using motorak.dal.Enums.CarEnums
@using Motorak.DAL.Enums.CarEnums
@using Motorak.BLL.ModelVM.Car

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@model List<CarListModel>

@{
    ViewData["Title"] = "Our Fleet";
}
<link rel="stylesheet" href="~/css/car.css">

<section class="featured section" id="featured">
    <div class="container">
        <h2 class="section__title">
            Our Fleet of Cars
        </h2>

        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
        {
            <div class="admin-controls" style="text-align: center; margin-bottom: 3rem;">
                <a asp-action="Create" class="button admin-button">
                    <i class='ri-add-line'></i> Add New Car
                </a>
            </div>
        }

        <!-- Filter buttons like homepage -->
        <div class="featured__filters">
            <button class="featured__item active-featured filter-btn" data-filter="all">
                <span>All</span>
            </button>
            <button class="featured__item filter-btn" data-filter="forsale">
                <span>For Sale</span>
            </button>
            <button class="featured__item filter-btn" data-filter="forrent">
                <span>For Rent</span>
            </button>
            <button class="featured__item filter-btn" data-filter="available">
                <span>Available</span>
            </button>
        </div>

        <div class="featured__content grid car-grid">
            @foreach (var car in Model)
            {

                <article class="featured__card car-card mix"
                         data-category="@car.Category.ToString().ToLower()"
                         data-status="@car.Status.ToString().ToLower()">
                    <div class="shape shape__smaller"></div>

                    <div class="car-header">
                        <h1 class="featured__title">@car.Brand</h1>
                        <h3 class="featured__subtitle">@car.Model (@car.Year)</h3>
                    </div>

                    <div class="car-image-container">
                        <img src="@Url.Content("~/" + (car.ImagePath ?? "assets/img/default-car.jpg"))"
                             alt="@car.Brand @car.Model"
                             class="featured__img car-image">
                    </div>

                    <!-- Car specifications -->
                    <div class="car-specs">
                        <div class="spec-item">
                            <i class="ri-dashboard-2-line"></i>
                            <span>@car.Mileage.ToString("N0") km</span>
                        </div>
                        <div class="spec-item">
                            <i class="ri-calendar-line"></i>
                            <span>@car.Year</span>
                        </div>
                        <div class="spec-item">
                            <i class="ri-car-line"></i>
                            <span>@car.Category</span>
                        </div>
                        <div class="spec-item">
                            <i class="ri-checkbox-circle-line"></i>
                            <span>@car.Status</span>
                        </div>
                    </div>

                    <!-- Pricing -->
                    <div class="car-pricing">
                        <h3 class="featured__price">$@car.Price.ToString("N0")</h3>
                        @if (car.DailyRentPrice.HasValue)
                        {
                            <div class="rent-price">
                                <small>Rent: $@car.DailyRentPrice.Value.ToString("N0")/day</small>
                            </div>
                        }
                    </div>

                    <div class="car-actions">
                        <a asp-action="Details" asp-route-id="@car.Id" class="button car-details-btn">
                            <i class='ri-eye-line'></i> Details
                        </a>

                        @if (SignInManager.IsSignedIn(User) && car.Status == CarStatus.Available)
                        {
                            <div class="quick-actions">
                                @if (car.Category == CarCategory.ForSale)
                                {
                                    <button class="quick-btn buy-btn" onclick="addToCart(@car.Id, 'buy')" title="Add to Cart (Buy)">
                                        <i class='ri-shopping-cart-line'></i>
                                    </button>
                                }
                                @if (car.Category == CarCategory.ForRent)
                                {
                                    <button class="quick-btn rent-btn" onclick="addToCart(@car.Id, 'rent')" title="Add to Cart (Rent)">
                                        <i class='ri-calendar-line'></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <div class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@car.Id" class="admin-btn edit-btn">
                                <i class='ri-edit-line'></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@car.Id" class="admin-btn delete-btn">
                                <i class='ri-delete-bin-line'></i>
                            </a>

                        </div>
                    }

                    <!-- Status and Category badges -->
                    <div class="availability-badges">
                        <span class="badge category-badge category-@car.Category.ToString().ToLower()">
                            @car.Category.ToString().Replace("For", "For ")
                        </span>
                        <span class="badge status-badge status-@car.Status.ToString().ToLower()">
                            @car.Status
                        </span>
                    </div>
                </article>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-content">
                    <i class="ri-car-line empty-icon"></i>
                    <h3>No Cars Available</h3>
                    <p>There are currently no cars in our fleet. Check back soon!</p>
                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="button">Add First Car</a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Cart notification -->
<div id="cart-notification" class="cart-notification">
    <div class="notification-content">
        <i class="ri-check-line"></i>
        <span id="notification-message">Item added to cart!</span>
    </div>
</div>

@* Anti-forgery token *@
<form style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/Car/list.js"></script>
}