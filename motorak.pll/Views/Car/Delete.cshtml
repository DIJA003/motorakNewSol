@using Motorak.BLL.ModelVM.Car

@model CarDetailsModel
@{
    ViewData["Title"] = $"Delete {Model.Brand} {Model.Model}";
}

<style>
    .delete-car-container {
        background: var(--body-color);
        min-height: 100vh;
        padding: 2rem 0;
        display: flex;
        align-items: center;
    }

    .delete-card {
        background: var(--container-color);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: none;
        overflow: hidden;
        max-width: 600px;
        margin: 0 auto;
    }

    .delete-card-header {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: var(--white-color);
        padding: 1.5rem 2rem;
        border: none;
        text-align: center;
    }

    .delete-card-body {
        padding: 2rem;
        text-align: center;
    }

    .warning-icon {
        font-size: 4rem;
        color: #dc3545;
        margin-bottom: 1rem;
        animation: pulse 2s infinite;
    }

    .car-info {
        background: rgba(220, 53, 69, 0.1);
        border: 2px solid rgba(220, 53, 69, 0.2);
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin: 1.5rem 0;
        text-align: left;
    }

        .car-info h5 {
            color: #dc3545;
            margin-bottom: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(220, 53, 69, 0.1);
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        font-weight: 600;
        color: var(--title-color);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .info-value {
        color: var(--text-color);
        font-weight: 500;
    }

    .warning-message {
        background: rgba(255, 193, 7, 0.1);
        border: 2px solid rgba(255, 193, 7, 0.3);
        border-radius: 0.5rem;
        padding: 1rem;
        margin: 1.5rem 0;
        color: #856404;
    }

        .warning-message h6 {
            color: #856404;
            font-weight: 700;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .warning-message ul {
            margin: 0.5rem 0 0 1.5rem;
            color: #856404;
        }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(220, 53, 69, 0.1);
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #c82333);
        border: none;
        color: var(--white-color);
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #c82333, #bd2130);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(220, 53, 69, 0.3);
            color: var(--white-color);
        }

    .btn-success {
        background: linear-gradient(135deg, #28a745, #218838);
        border: none;
        color: var(--white-color);
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #218838, #1e7e34);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(40, 167, 69, 0.3);
            color: var(--white-color);
        }

    .btn-secondary {
        background: rgba(108, 117, 125, 0.1);
        border: 2px solid rgba(108, 117, 125, 0.2);
        color: #6c757d;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
    }

        .btn-secondary:hover {
            background: #6c757d;
            color: var(--white-color);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(108, 117, 125, 0.2);
        }

    .car-image {
        width: 150px;
        height: 100px;
        object-fit: cover;
        border-radius: 0.5rem;
        margin: 1rem auto;
        display: block;
        border: 3px solid rgba(220, 53, 69, 0.2);
    }

</style>

<div class="delete-car-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="delete-card">
                    <div class="delete-card-header">
                        <h3 class="mb-0">
                            <i class="ri-delete-bin-line me-2"></i>
                            Confirm Delete
                        </h3>
                        <p class="mb-0 mt-2 opacity-75">This action cannot be undone</p>
                    </div>
                    <div class="delete-card-body">
                        <div class="warning-icon">
                            <i class="ri-error-warning-line"></i>
                        </div>

                        <h4 class="text-danger mb-3">
                            Are you sure you want to delete this car?
                        </h4>

                        <p class="text-muted mb-4">
                            You are about to permanently delete the following vehicle from the system.
                            This action cannot be reversed.
                        </p>

                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@(Model.ImagePath ?? "/images/default-car.jpg")"
                                 class="car-image"
                                 alt="@Model.Brand @Model.Model">
                        }

                        <div class="car-info">
                            <h5>
                                <i class="ri-car-line"></i>
                                Vehicle Information
                            </h5>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-hashtag"></i>
                                    ID
                                </span>
                                <span class="info-value">#@Model.Id</span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-car-line"></i>
                                    Vehicle
                                </span>
                                <span class="info-value">@Model.Brand @Model.Model (@Model.Year)</span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-palette-line"></i>
                                    Color
                                </span>
                                <span class="info-value">@Model.Color</span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-dashboard-line"></i>
                                    Mileage
                                </span>
                                <span class="info-value">@Model.Mileage.ToString("N0") miles</span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-money-dollar-circle-line"></i>
                                    Price
                                </span>
                                <span class="info-value">$@Model.Price.ToString("N0")</span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-shield-check-line"></i>
                                    Condition
                                </span>
                                <span class="info-value">@Model.Condition</span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    <i class="ri-price-tag-3-line"></i>
                                    Category
                                </span>
                                <span class="info-value">@Model.Category</span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.OwnerName))
                            {
                                <div class="info-row">
                                    <span class="info-label">
                                        <i class="ri-user-line"></i>
                                        Owner
                                    </span>
                                    <span class="info-value">@Model.OwnerName</span>
                                </div>
                            }
                        </div>

                        <div class="warning-message">
                            <h6>
                                <i class="ri-alert-line"></i>
                                Warning - This will also:
                            </h6>
                            <ul>
                                <li>Remove all associated rental history</li>
                                <li>Cancel any pending reservations</li>
                                <li>Delete uploaded images and documents</li>
                                <li>Remove from customer wishlists and cart items</li>
                                <li>Update inventory reports and statistics</li>
                            </ul>
                        </div>

                        <div class="action-buttons">
                            <a asp-action="Index" class="btn-secondary">
                                <i class="ri-arrow-left-line"></i>
                                Cancel
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-success">
                                <i class="ri-eye-line"></i>
                                View Details
                            </a>
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-danger" onclick="return confirmDelete()">
                                    <i class="ri-delete-bin-line"></i>
                                    Delete Permanently
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete() {
        return confirm('Are you absolutely sure you want to delete this car? This action cannot be undone and will permanently remove all associated data.');
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Add keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // ESC key to cancel
            if (e.key === 'Escape') {
                window.location.href = '@Url.Action("Index")';
            }
        });

        // Add double-click protection on delete button
        const deleteButton = document.querySelector('.btn-danger');
        let deleteClicked = false;

        deleteButton.addEventListener('click', function(e) {
            if (deleteClicked) {
                e.preventDefault();
                return false;
            }

            if (confirmDelete()) {
                deleteClicked = true;
                this.innerHTML = '<i class="ri-loader-4-line"></i> Deleting...';
                this.disabled = true;
                return true;
            } else {
                e.preventDefault();
                return false;
            }
        });
    });
</script>