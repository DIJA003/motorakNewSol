@model List<Motorak.BLL.ModelVM.Car.CarListModel>
@{
    ViewData["Title"] = "Available Cars";
}

<section class="dashboard" id="cars">
    <div class="container">
        <h2 class="section__title">Vehicle Management</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="ri-check-line"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="ri-error-warning-line"></i> @TempData["Error"]
            </div>
        }

        <div class="dashboard__nav">
            <button class="dashboard__tab active" data-tab="buy">Buy Cars</button>
            <button class="dashboard__tab" data-tab="rent">Rent Cars</button>
            @if (User.IsInRole("Admin"))
            {
                <button class="dashboard__tab" data-tab="manage">Manage Cars</button>
            }
        </div>

        <!-- Buy Cars Tab -->
        <div class="dashboard__content active" id="buy-tab">
            <div class="car__grid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var car in Model.Where(c => c.Status == Motorak.DAL.Enums.CarEnums.CarStatus.Available))
                    {
                        <div class="car__card">
                            <div class="car__image">
                                @if (!string.IsNullOrEmpty(car.ImagePath))
                                {
                                    <img src="@car.ImagePath" alt="@car.Brand @car.Model" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="ri-car-fill"></i>
                                }
                            </div>
                            <div class="car__content">
                                <h3 class="car__title">@car.Brand @car.Model</h3>
                                <div class="car__details">
                                    <span class="car__detail">
                                        <i class="ri-calendar-line"></i> @car.Year
                                    </span>
                                    <span class="car__detail">
                                        <i class="ri-road-map-line"></i> @car.Mileage km
                                    </span>
                                </div>
                                <div class="car__price">@car.Price.ToString("C")</div>
                                <div class="car__actions">
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <form asp-action="Sell" method="post" style="display:inline;">
                                            <input type="hidden" name="carId" value="@car.Id" />
                                            <button type="submit" class="btn btn-success btn-small">Purchase</button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-info btn-small">Details</a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center" style="grid-column: 1 / -1;">
                        <i class="ri-car-line" style="font-size: 4rem; color: var(--text-color-light);"></i>
                        <h3>No cars available for purchase</h3>
                        <p style="color: var(--text-color-light);">Check back later for new arrivals</p>
                    </div>
                }
            </div>
        </div>

        <!-- Rent Cars Tab -->
        <div class="dashboard__content" id="rent-tab">
            <div class="car__grid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var car in Model.Where(c => c.Status == Motorak.DAL.Enums.CarEnums.CarStatus.Available))
                    {
                        <div class="car__card">
                            <div class="car__image">
                                @if (!string.IsNullOrEmpty(car.ImagePath))
                                {
                                    <img src="@car.ImagePath" alt="@car.Brand @car.Model" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="ri-car-line"></i>
                                }
                            </div>
                            <div class="car__content">
                                <h3 class="car__title">@car.Brand @car.Model</h3>
                                <div class="car__details">
                                    <span class="car__detail">
                                        <i class="ri-calendar-line"></i> @car.Year
                                    </span>
                                    <span class="car__detail">
                                        <i class="ri-road-map-line"></i> @car.Mileage km
                                    </span>
                                </div>
                                <div class="car__price">$@car.Price/day</div>
                                <div class="car__actions">
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <form asp-action="Rent" method="post" style="display:inline;">
                                            <input type="hidden" name="carId" value="@car.Id" />
                                            <button type="submit" class="btn btn-warning btn-small">Rent Now</button>
                                        </form>
                                    }
                                    <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-info btn-small">Details</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Admin Manage Cars Tab -->
        @if (User.IsInRole("Admin"))
        {
            <div class="dashboard__content" id="manage-tab">
                <div class="car__grid">
                    <div class="car__card">
                        <div class="car__image">
                            <i class="ri-add-line"></i>
                        </div>
                        <div class="car__content">
                            <h3 class="car__title">Add New Vehicle</h3>
                            <p style="color: var(--text-color-light); font-size: var(--small-font-size);">Click to add a new vehicle to the inventory</p>
                            <div class="car__actions">
                                <a asp-action="Create" class="btn btn-primary btn-small" style="width: 100%;">Add Vehicle</a>
                            </div>
                        </div>
                    </div>

                    @foreach (var car in Model ?? new List<Motorak.BLL.ModelVM.Car.CarListModel>())
                    {
                        <div class="car__card">
                            <div class="car__image">
                                @if (!string.IsNullOrEmpty(car.ImagePath))
                                {
                                    <img src="@car.ImagePath" alt="@car.Brand @car.Model" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="ri-car-fill"></i>
                                }
                            </div>
                            <div class="car__content">
                                <h3 class="car__title">@car.Brand @car.Model</h3>
                                <div class="car__details">
                                    <span class="car__detail">
                                        <i class="ri-calendar-line"></i> @car.Year
                                    </span>
                                    <span class="car__detail">
                                        <i class="ri-road-map-line"></i> @car.Mileage km
                                    </span>
                                </div>
                                <div class="car__price">@car.Price.ToString("C")</div>
                                <div class="car__actions">
                                    <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-info btn-small">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-danger btn-small">Delete</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>