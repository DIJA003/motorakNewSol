@using Microsoft.AspNetCore.Identity
@using motorak.dal.Entites;

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="nav__auth">
        <a id="manage" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage Account">
            @{
                var userName = UserManager.GetUserName(User);
                var initials = !string.IsNullOrEmpty(userName) ? userName.Substring(0, Math.Min(2, userName.Length)).ToUpper() : "U";
            }
            <div class="nav__user-avatar">@initials</div>
            <span>@userName</span>
        </a>

        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="display: inline;">
            <button id="logout" type="submit">
                <i class="ri-logout-circle-line"></i>
                @SharedLocalizer["Logout"]
            </button>
        </form>
    </div>
}
else
{
    <div class="nav__auth">
        <a id="register" asp-area="Identity" asp-page="/Account/Register">
            <i class="ri-user-add-line"></i>
            @SharedLocalizer["Register"]
        </a>
        <a id="login" asp-area="Identity" asp-page="/Account/Login">
            <i class="ri-login-circle-line"></i>
            @SharedLocalizer["SignIn"]
        </a>
    </div>
}