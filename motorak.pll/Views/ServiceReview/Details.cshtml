@using Motorak.BLL.ModelVM.ServiceReview
@model ServiceReviewDTO
@{
    ViewBag.Title = "Service Review Details";
}

<style>
    body {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .review-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        transform: translateY(20px);
        opacity: 0;
        transition: all 1s ease-out;
    }

        .review-container.loaded {
            transform: translateY(0);
            opacity: 1;
        }

    .sparkle-icon {
        color: #a855f7;
        font-size: 2rem;
        margin: 0 0.5rem;
        filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.5));
        transition: all 0.3s ease;
        display: inline-block;
        transform: rotate(0deg) scale(1);
    }

        .sparkle-icon:hover {
            transform: scale(1.2) rotate(180deg);
            filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.8));
        }

    .main-title {
        text-align: center;
        color: #ffffff;
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-shadow: 0 0 20px rgba(168, 85, 247, 0.6);
        transform: translateY(-30px);
        opacity: 0;
        transition: all 1s ease-out;
    }

        .main-title.loaded {
            transform: translateY(0);
            opacity: 1;
            text-shadow: 0 0 30px rgba(168, 85, 247, 1);
        }

    .subtitle {
        text-align: center;
        color: #a1a1aa;
        font-size: 1.1rem;
        margin-bottom: 3rem;
        opacity: 0;
        transform: translateY(20px);
        transition: all 1.2s ease-out 0.3s;
    }

        .subtitle.loaded {
            opacity: 0.9;
            transform: translateY(0);
        }

    .review-card {
        background: linear-gradient(145deg, rgba(30, 30, 60, 0.8), rgba(20, 20, 40, 0.9));
        border-radius: 20px;
        border: 1px solid rgba(168, 85, 247, 0.3);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(168, 85, 247, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        opacity: 0;
        transform: scale(0.9);
        transition: all 0.8s ease-out 0.5s, box-shadow 0.3s ease;
    }

        .review-card.loaded {
            opacity: 1;
            transform: scale(1);
        }

        .review-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #a855f7, #c084fc, #e879f9);
            border-radius: 20px 20px 0 0;
        }

        .review-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), 0 0 40px rgba(168, 85, 247, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        }

    .card-header {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(192, 132, 252, 0.1));
        border: none;
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        text-align: center;
        position: relative;
        opacity: 0;
        transform: translateY(-20px);
        transition: all 1s ease-out 0.8s;
    }

        .card-header.loaded {
            opacity: 1;
            transform: translateY(0);
        }

        .card-header h4 {
            color: #ffffff;
            font-size: 1.8rem;
            font-weight: 600;
            margin: 0;
            text-shadow: 0 2px 10px rgba(168, 85, 247, 0.5);
        }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 1.2rem 0;
        border-bottom: 1px solid rgba(168, 85, 247, 0.1);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0;
        transform: translateY(20px);
    }

        .detail-row.loaded {
            opacity: 1;
            transform: translateY(0);
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row:hover {
            background: rgba(168, 85, 247, 0.05);
            border-radius: 10px;
            padding-left: 1rem;
            padding-right: 1rem;
        }

    .detail-label {
        flex: 0 0 200px;
        color: #a855f7;
        font-weight: 600;
        font-size: 1.1rem;
        text-shadow: 0 1px 3px rgba(168, 85, 247, 0.3);
    }

    .detail-value {
        flex: 1;
        color: #ffffff;
        font-size: 1rem;
        line-height: 1.6;
    }

    .rating-stars {
        display: inline-flex;
        gap: 0.3rem;
    }

    .star {
        font-size: 1.5rem;
        color: #fbbf24;
        filter: drop-shadow(0 2px 4px rgba(251, 191, 36, 0.4));
        transition: transform 0.2s ease;
    }

        .star:hover {
            transform: scale(1.2);
        }

        .star.filled {
            color: #f59e0b;
            text-shadow: 0 0 10px rgba(245, 158, 11, 0.6);
            transition: all 0.3s ease;
            transform: scale(1);
        }

            .star.filled:hover {
                transform: scale(1.15);
                text-shadow: 0 0 20px rgba(245, 158, 11, 1);
            }

    .review-id-badge {
        background: linear-gradient(135deg, #a855f7, #c084fc);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
        transition: all 0.3s ease;
        transform: scale(1);
    }

        .review-id-badge:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(168, 85, 247, 0.5);
        }

    .id-badge {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(192, 132, 252, 0.2));
        color: #e5e7eb;
        padding: 0.3rem 0.8rem;
        border-radius: 15px;
        border: 1px solid rgba(168, 85, 247, 0.3);
        font-weight: 500;
        display: inline-block;
        transition: all 0.3s ease;
    }

        .id-badge:hover {
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.3), rgba(192, 132, 252, 0.3));
            transform: scale(1.05);
        }

    .comment-text {
        background: rgba(168, 85, 247, 0.1);
        padding: 1rem;
        border-radius: 10px;
        border-left: 4px solid #a855f7;
        color: #f3f4f6;
        font-style: italic;
        line-height: 1.7;
        transition: all 0.3s ease;
    }

        .comment-text:hover {
            background: rgba(168, 85, 247, 0.15);
            transform: translateX(5px);
        }

    .back-button {
        background: linear-gradient(135deg, #374151, #4b5563);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 25px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(75, 85, 99, 0.3);
        margin-top: 2rem;
        opacity: 0;
        transform: translateX(30px);
    }

        .back-button.loaded {
            opacity: 1;
            transform: translateX(0);
            transition: all 1s ease-out 1.2s, transform 0.3s ease;
        }

        .back-button:hover {
            background: linear-gradient(135deg, #4b5563, #6b7280);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(75, 85, 99, 0.4);
            color: white;
            text-decoration: none;
        }

            .back-button:hover i {
                transform: translateX(-5px);
            }

    .floating-elements {
        position: absolute;
        top: 20px;
        right: 20px;
        opacity: 0.1;
        font-size: 3rem;
        color: #a855f7;
        pointer-events: none;
        transform: translateY(0);
        transition: transform 2s ease-in-out;
    }

        .floating-elements:hover {
            transform: translateY(-10px) rotate(15deg);
        }

    .review-card::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.1) 0%, transparent 70%);
        transform: translate(-50%, -50%);
        transition: all 2s ease;
        pointer-events: none;
    }

    .review-card:hover::after {
        width: 400px;
        height: 400px;
    }

    :root {
        --glow-color: #a855f7;
        --glow-size: 20px;
        --transition-speed: 0.3s;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="review-container">
    <div class="floating-elements">
        <i class="bi bi-stars"></i>
    </div>

    <h1 class="main-title">
        <i class="sparkle-icon bi bi-stars"></i>
        Service Review Details
        <i class="sparkle-icon bi bi-stars"></i>
    </h1>

    <p class="subtitle">Your feedback helps us improve and serve you better</p>

    <div class="review-card">
        <div class="card-header">
            <h4><i class="bi bi-chat-square-heart-fill" style="margin-right: 0.5rem;"></i> Review Information</h4>
        </div>

        <div class="card-body">
            <div class="detail-row animated-row">
                <div class="detail-label">
                    <i class="bi bi-hash" style="margin-right: 0.5rem;"></i>Review ID:
                </div>
                <div class="detail-value">
                    <span class="review-id-badge">@Model.ReviewId</span>
                </div>
            </div>

            <div class="detail-row animated-row">
                <div class="detail-label">
                    <i class="bi bi-star-fill" style="margin-right: 0.5rem;"></i>Rating:
                </div>
                <div class="detail-value">
                    <div class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.Rating)
                            {
                                <i class="bi bi-star-fill star filled"></i>
                            }
                            else
                            {
                                <i class="bi bi-star star"></i>
                            }
                        }
                        <span style="margin-left: 1rem; color: #a855f7; font-weight: 600;">(@Model.Rating/5)</span>
                    </div>
                </div>
            </div>

            <div class="detail-row animated-row">
                <div class="detail-label">
                    <i class="bi bi-chat-quote-fill" style="margin-right: 0.5rem;"></i>Comment:
                </div>
                <div class="detail-value">
                    <div class="comment-text">
                        "@Model.Comments"
                    </div>
                </div>
            </div>

            <div class="detail-row animated-row">
                <div class="detail-label">
                    <i class="bi bi-gear-fill" style="margin-right: 0.5rem;"></i>Service ID:
                </div>
                <div class="detail-value">
                    <span class="id-badge">@Model.ServiceId</span>
                </div>
            </div>

            <div class="detail-row animated-row">
                <div class="detail-label">
                    <i class="bi bi-person-fill" style="margin-right: 0.5rem;"></i>Customer ID:
                </div>
                <div class="detail-value">
                    <span class="id-badge">@Model.CustomerId</span>
                </div>
            </div>

            <a asp-action="Index" class="back-button">
                <i class="bi bi-arrow-left-circle-fill"></i>
                Back to Reviews List
            </a>
        </div>
    </div>
</div>

<script>
    // Add loaded class after page loads for animations
    window.addEventListener('load', function() {
        setTimeout(() => {
            document.querySelector('.review-container').classList.add('loaded');
            document.querySelector('.main-title').classList.add('loaded');
            document.querySelector('.subtitle').classList.add('loaded');
            document.querySelector('.review-card').classList.add('loaded');
            document.querySelector('.card-header').classList.add('loaded');
            document.querySelector('.back-button').classList.add('loaded');

            // Add loaded class to rows with staggered delay
            const rows = document.querySelectorAll('.detail-row');
            rows.forEach((row, index) => {
                setTimeout(() => {
                    row.classList.add('loaded');
                }, 1000 + (index * 150));
            });
        }, 100);
    });
</script>