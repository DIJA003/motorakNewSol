@using motorak.bll.ModelVM.ShoppingCart;
@using motorak.dal.Enums.CartEnums;

@model List<ShoppingCartVM>
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="fas fa-shopping-cart"></i> Your Shopping Cart
                <span class="badge badge-primary ml-2" id="cart-count">@Model.Sum(c => c.Count)</span>
            </h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Your cart is empty</h4>
            <p class="text-muted">Browse our cars and add items to your cart</p>
            <a href="@Url.Action("Index", "Car")" class="btn btn-primary">Browse Cars</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    <div class="card mb-3 cart-item" data-cart-id="@item.Id">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <img src="@(item.ImagePath ?? "/images/default-car.jpg")"
                                         class="img-fluid rounded" alt="@item.Brand @item.Model">
                                </div>
                                <div class="col-md-6">
                                    <h5 class="card-title">@item.Brand @item.Model (@item.Year)</h5>
                                    <p class="card-text">
                                        <span class="badge badge-@(item.ItemType == CartItemType.Rent ? "info" : "success")">
                                            @item.ItemType.ToString().ToUpper()
                                        </span>
                                    </p>

                                    @if (item.ItemType == CartItemType.Rent)
                                    {
                                        <div class="rent-details">
                                            <small class="text-muted">
                                                <i class="fas fa-calendar"></i>
                                                @item.RentStartDate?.ToString("MM/dd/yyyy") - @item.RentEndDate?.ToString("MM/dd/yyyy")
                                                (@item.RentDays days)
                                            </small>
                                            <div class="mt-2">
                                                <input type="date" class="form-control form-control-sm rent-start"
                                                       value="@item.RentStartDate?.ToString("yyyy-MM-dd")"
                                                       onchange="updateRentDates(@item.Id, this.value, document.querySelector('[data-cart-id=@item.Id] .rent-end').value)">
                                                <input type="date" class="form-control form-control-sm rent-end mt-1"
                                                       value="@item.RentEndDate?.ToString("yyyy-MM-dd")"
                                                       onchange="updateRentDates(@item.Id, document.querySelector('[data-cart-id=@item.Id] .rent-start').value, this.value)">
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-3 text-right">
                                    <div class="quantity-controls mb-2">
                                        <div class="input-group input-group-sm">
                                            <div class="input-group-prepend">
                                                <button class="btn btn-outline-secondary" type="button"
                                                        onclick="updateQuantity(@item.Id, @item.Count - 1)">
                                                    <i class="fas fa-minus"></i>
                                                </button>
                                            </div>
                                            <input type="number" class="form-control text-center"
                                                   value="@item.Count" min="1" max="10"
                                                   onchange="updateQuantity(@item.Id, this.value)">
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button"
                                                        onclick="updateQuantity(@item.Id, @item.Count + 1)">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="price-display">
                                        @if (item.ItemType == CartItemType.Rent)
                                        {
                                            <div class="text-muted small">$@item.DailyRentPrice/day</div>
                                        }
                                        <strong class="item-total">$@item.TotalPrice.ToString("F2")</strong>
                                    </div>

                                    <button class="btn btn-danger btn-sm mt-2" onclick="removeFromCart(@item.Id)">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <div class="card sticky-top">
                    <div class="card-header">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Items (@Model.Sum(c => c.Count)):</span>
                            <span id="subtotal">$@Model.Sum(c => c.TotalPrice).ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax:</span>
                            <span id="tax">$@((Model.Sum(c => c.TotalPrice) * 0.08m).ToString("F2"))</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total:</strong>
                            <strong id="total">$@((Model.Sum(c => c.TotalPrice) * 1.08m).ToString("F2"))</strong>
                        </div>

                        <button class="btn btn-primary btn-block btn-lg" onclick="proceedToCheckout()">
                            <i class="fas fa-credit-card"></i> Proceed to Checkout
                        </button>

                        <button class="btn btn-outline-secondary btn-block mt-2" onclick="clearCart()">
                            <i class="fas fa-trash-alt"></i> Clear Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>