@using Motorak.BLL.ModelVM.ServiceReview
@model List<ServiceReviewDTO>

@{
    ViewBag.Title = "Service Reviews";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="text-primary fw-bold">Service Reviews</h2>
        <p class="text-muted">Browse and manage all customer service reviews</p>
    </div>

    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-stars"></i> Reviews List</span>
            <a asp-action="Create" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Add Review
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            @* <th>#</th> *@
                            <th>Service ID</th>
                            <th>Customer ID</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            @* <th>Status</th> *@
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model)
                        {
                            <tr>
                                <td>@review.ReviewId</td>
                                <td>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-warning"></i>
                                        }
                                    }
                                </td>
                                <td>@review.Comments</td>
                                <td>@review.ServiceId</td>
                                <td>@review.CustomerId</td>
                                @* <td>
                                    @if (review.Status == "Completed")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Completed</span>
                                    }
                                    else if (review.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Pending</span>
                                    }
                                    else if (review.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@review.Status</span>
                                    }
                                </td> *@
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@review.ReviewId" class="btn btn-info btn-sm"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@review.ReviewId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@review.ReviewId" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
