@model Motorak.BLL.ModelVM.Purchases.PurchaseReadDto

@{
    ViewData["Title"] = "Delete Purchase";
}

<div class="container mt-5">
    <h1 class="h3 mb-4 text-danger">Delete Purchase (Soft Delete)</h1>

    <div class="alert alert-warning" role="alert">
        This will <strong>soft delete</strong> the purchase. It will no longer be visible in lists but remains in the database.
        Are you sure you want to continue?
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Purchase ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Payment Method</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>

                <dt class="col-sm-3">Total Price</dt>
                <dd class="col-sm-9">@Model.TotalPrice.ToString("C")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>
        </div>
    </div>

    <form asp-action="DeletePost" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2">
            <i class="ri-delete-bin-line"></i> Soft Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
