@using Motorak.BLL.ModelVM.Service
@using Motorak.DAL.Enums.SeviceEnums
@model CreateServiceVM

@{
    ViewData["Title"] = "Create New Service";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-5">
    <h1 class="mb-4 text-success">Create New Service</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="RequestDate" class="form-label"></label>
            <input asp-for="RequestDate" class="form-control" type="date" />
            <span asp-validation-for="RequestDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ServiceType" class="form-label"></label>
            <select asp-for="ServiceType" class="form-select" asp-items="Html.GetEnumSelectList<ServiceType>()"></select>
            <span asp-validation-for="ServiceType" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Status>()"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerId" class="form-label"></label>
            <input asp-for="CustomerId" class="form-control" type="number" />
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MechanicId" class="form-label"></label>
            <input asp-for="MechanicId" class="form-control" type="number" />
            <span asp-validation-for="MechanicId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CarId" class="form-label"></label>
            <input asp-for="CarId" class="form-control" type="number" />
            <span asp-validation-for="CarId" class="text-danger"></span>
        </div>

        
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Create Service
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="bi bi-x-circle"></i> Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
