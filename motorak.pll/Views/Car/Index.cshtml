
@using Microsoft.AspNetCore.Identity
@using Motorak.DAL.Entites
@using motorak.dal.Entites

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@model IEnumerable<Motorak.BLL.ModelVM.Car.CarListModel>

@{
    ViewData["Title"] = "Our Fleet";
}

<section class="featured section" id="featured">
    <div class="container">
        <h2 class="section__title">
            Our Fleet of Cars
        </h2>

        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
        {
            <p style="margin-bottom: 2rem;">
                <a asp-action="Create" class="button">
                    <i class='bx bx-plus'></i> Add New Car
                </a>
            </p>
        }

        <div class="featured__content grid">

            @* We loop through the car data from the controller *@
            @foreach (var car in Model)
            {
                <article class="featured__card">
                    <div class="shape shape__smaller"></div>

                    <h1 class="featured__title">@car.Brand</h1>
                    <h3 class="featured__subtitle">@car.Model (@car.Year)</h3>

                    <img src="@Url.Content(car.ImagePath ?? "~/assets/img/featured1.png")" alt="@car.Brand @car.Model" class="featured__img">

                    <h3 class="featured__price">$@car.Price.ToString("N0")</h3>

                    <a asp-action="Details" asp-route-id="@car.Id" class="button featured__button">
                        <i class='bx bx-show'></i> Details
                    </a>

                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <div class="admin-actions" style="margin-top: 1rem;">
                            <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-info" style="color:white; background-color: #007bff; padding: 5px 10px; border-radius: 5px; text-decoration: none;">Edit</a>
                            <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-danger" style="color:white; background-color: #dc3545; padding: 5px 10px; border-radius: 5px; text-decoration: none;">Delete</a>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>