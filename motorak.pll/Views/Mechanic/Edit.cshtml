@using Motorak.BLL.ModelVM.Mechanic
@model EditMechanicModel
@{
    Layout = null;
}
<style>
    body {
        background-color: #1a001f;
        color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #e0c3ff;
    }

    .card-purple {
        background-color: #2a0044;
        border: 1px solid #5a00a3;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(90, 0, 163, 0.4);
        padding: 20px;
        margin-bottom: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-purple:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(90, 0, 163, 0.6);
    }

    .card-header {
        font-size: 1.2rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 15px;
    }

    .form-control, .form-select {
        background-color: #35005c;
        color: white;
        border: 1px solid #5a00a3;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .btn-primary {
        background-color: #4b007d;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-primary:hover {
        background-color: #5a00a3;
    }
</style>

<h1>Edit Mechanic</h1>

<div class="card-purple">
    <div class="card-header">Mechanic Information</div>
    <form asp-controller="Mechanic" asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-control" placeholder="Enter Name" />

        <div class="form-group">
            <label asp-for="WorkHours">Work Hours</label>
            <select asp-for="WorkHours" class="form-select">
                <option disabled selected>Choose Work Hours</option>
                <option value="1">7AM - 4PM</option>
                <option value="2">4PM - 1AM</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="WorkHours">Status</label>
            <select asp-for="WorkHours" class="form-select">
                <option disabled selected>Choose Status</option>
                <option value="1">Free</option>
                <option value="2">Busy</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>
