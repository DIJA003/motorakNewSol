@using Motorak.BLL.ModelVM.Service
@model UpdateServiceVM
@{
    ViewData["Title"] = "Edit Service";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden;
    }

    .animated-container {
        transform: translateY(20px);
        opacity: 0;
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .animated-container.loaded {
            transform: translateY(0);
            opacity: 1;
        }

    .glass-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
        transform: scale(0.95);
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

        .glass-card:hover {
            transform: scale(1) translateY(-5px);
            box-shadow: 0 35px 80px rgba(0, 0, 0, 0.5);
            background: rgba(255, 255, 255, 0.08);
        }

    .title-animated {
        background: linear-gradient(45deg, #64ffda, #18ffff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 800;
        letter-spacing: -0.5px;
        transform: translateX(-30px);
        opacity: 0;
        transition: all 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        position: relative;
        overflow: hidden;
        text-shadow: 0 0 30px rgba(100, 255, 218, 0.3);
    }

        .title-animated::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 2s ease-in-out;
        }

        .title-animated:hover::after {
            left: 100%;
        }

    .form-group-animated {
        position: relative;
        margin-bottom: 30px;
        transform: translateX(50px);
        opacity: 0;
        transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
    }

    .form-label-floating {
        position: absolute;
        top: 15px;
        left: 15px;
        color: rgba(255, 255, 255, 0.7);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        pointer-events: none;
        font-weight: 500;
        background: transparent;
        padding: 0;
        z-index: 2;
    }

    .form-group-animated.focused .form-label-floating,
    .form-group-animated.has-value .form-label-floating {
        top: -10px;
        left: 10px;
        font-size: 12px;
        color: #64ffda;
        background: rgba(26, 26, 46, 0.9);
        padding: 2px 8px;
        border-radius: 8px;
    }

    .form-control-enhanced {
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        color: #e0e0e0;
        font-size: 16px;
        padding: 15px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        width: 100%;
    }

        .form-control-enhanced::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #64ffda, transparent);
            transition: left 0.6s;
        }

        .form-control-enhanced:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #64ffda;
            box-shadow: 0 0 20px rgba(100, 255, 218, 0.2);
            transform: scale(1.02);
            color: #ffffff;
            outline: none;
        }

            .form-control-enhanced:focus::before {
                left: 100%;
            }

    .select-enhanced {
        appearance: none;
        background: rgba(255, 255, 255, 0.03) url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364ffda' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m6 8 4 4 4-4'/%3e%3c/svg%3e") no-repeat right 15px center;
        background-size: 16px 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

        .select-enhanced:hover {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: rgba(100, 255, 218, 0.3);
        }

        .select-enhanced:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: #64ffda;
            box-shadow: 0 0 20px rgba(100, 255, 218, 0.2);
        }

        .select-enhanced option {
            background-color: #1a1a2e;
            color: #e0e0e0;
            padding: 10px;
        }

            .select-enhanced option:hover {
                background-color: #2a2a3e;
            }

            .select-enhanced option[value=""] {
                color: #888;
                font-style: italic;
            }

    .btn-enhanced {
        background: linear-gradient(135deg, #1e3a8a, #1e40af);
        border: none;
        border-radius: 50px;
        color: white;
        font-weight: 600;
        padding: 15px 30px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 20px rgba(30, 58, 138, 0.4);
        transform: translateY(0);
        cursor: pointer;
    }

        .btn-enhanced::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(100, 255, 218, 0.2), transparent);
            transition: left 0.6s;
        }

        .btn-enhanced:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 20px 40px rgba(30, 58, 138, 0.5);
            background: linear-gradient(135deg, #1e40af, #2563eb);
        }

            .btn-enhanced:hover::before {
                left: 100%;
            }

        .btn-enhanced:active {
            transform: translateY(-1px) scale(1.02);
            transition: all 0.1s;
        }

    .btn-secondary-enhanced {
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px;
        color: #e0e0e0;
        font-weight: 600;
        padding: 15px 30px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(10px);
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-secondary-enhanced:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(100, 255, 218, 0.5);
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(100, 255, 218, 0.1);
            color: #ffffff;
            text-decoration: none;
        }

    .alert-enhanced {
        background: rgba(244, 67, 54, 0.08);
        border: 2px solid rgba(244, 67, 54, 0.2);
        border-radius: 16px;
        color: #ff8a80;
        backdrop-filter: blur(15px);
        margin-bottom: 25px;
        transform: scale(0.95);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        padding: 15px;
    }

        .alert-enhanced:hover {
            transform: scale(1);
            background: rgba(244, 67, 54, 0.12);
        }

    .icon-bounce {
        transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        margin-right: 8px;
    }

    .btn-enhanced:hover .icon-bounce,
    .btn-secondary-enhanced:hover .icon-bounce {
        transform: scale(1.2) rotate(5deg);
    }

    .floating-elements {
        position: fixed;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: -1;
    }

    .floating-circle {
        position: absolute;
        border-radius: 50%;
        background: rgba(100, 255, 218, 0.05);
        transition: all 2s ease-in-out;
        border: 1px solid rgba(100, 255, 218, 0.1);
    }

        .floating-circle:nth-child(1) {
            width: 100px;
            height: 100px;
            top: 10%;
            left: 20%;
            transform: translateY(0);
        }

        .floating-circle:nth-child(2) {
            width: 150px;
            height: 150px;
            top: 60%;
            right: 10%;
            transform: translateY(0);
        }

        .floating-circle:nth-child(3) {
            width: 80px;
            height: 80px;
            bottom: 20%;
            left: 10%;
            transform: translateY(0);
        }

    .validation-error {
        color: #ff8a80;
        font-size: 14px;
        margin-top: 8px;
        opacity: 0;
        transform: translateY(-10px);
        transition: all 0.3s ease;
    }

        .validation-error.show {
            opacity: 1;
            transform: translateY(0);
        }

    .ripple-animation {
        transform: scale(0);
        opacity: 1;
        transition: transform 0.6s ease-out, opacity 0.6s ease-out;
    }

        .ripple-animation.active {
            transform: scale(4);
            opacity: 0;
        }
</style>

<div class="floating-elements">
    <div class="floating-circle"></div>
    <div class="floating-circle"></div>
    <div class="floating-circle"></div>
</div>

<div class="container mt-5 animated-container" style="margin-top: 8rem !important;">
    <div class="glass-card">
        <h1 class="mb-4 title-animated">Edit Service - ID @Model.ServiceId</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-enhanced">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Edit" method="post" novalidate>
            <input asp-for="ServiceId" type="hidden" />

            <div class="form-group-animated">
                <label class="form-label-floating">Service Status</label>
                <select asp-for="Status" class="form-control-enhanced select-enhanced">
                    <option value="">Select Status</option>
                    <option value="Pending" selected="@(Model.Status.ToString() == "Pending")">Pending</option>
                    <option value="Completed" selected="@(Model.Status.ToString() == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(Model.Status.ToString() == "Cancelled")">Cancelled</option>
                </select>
                <span asp-validation-for="Status" class="validation-error"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn-enhanced">
                    <i class="bi bi-save icon-bounce"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn-secondary-enhanced">
                    <i class="bi bi-x-circle icon-bounce"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const container = document.querySelector('.animated-container');
        setTimeout(() => {
            container.classList.add('loaded');
        }, 100);

        setTimeout(() => {
            document.querySelector('.title-animated').style.transform = 'translateX(0)';
            document.querySelector('.title-animated').style.opacity = '1';
        }, 200);

        setTimeout(() => {
            document.querySelector('.form-group-animated').style.transform = 'translateX(0)';
            document.querySelector('.form-group-animated').style.opacity = '1';
        }, 400);

        const selectControl = document.querySelector('.select-enhanced');
        const formGroup = selectControl.parentElement;
        const label = formGroup.querySelector('.form-label-floating');

        function updateLabelPosition() {
            if (selectControl.value !== '') {
                formGroup.classList.add('has-value');
            } else {
                formGroup.classList.remove('has-value');
            }
        }

        updateLabelPosition();

        selectControl.addEventListener('focus', function() {
            formGroup.classList.add('focused');
        });

        selectControl.addEventListener('blur', function() {
            formGroup.classList.remove('focused');
            updateLabelPosition();
        });

        selectControl.addEventListener('change', function() {
            updateLabelPosition();
        });

        document.addEventListener('mousemove', (e) => {
            const circles = document.querySelectorAll('.floating-circle');
            circles.forEach((circle, index) => {
                const speed = (index + 1) * 0.5;
                const x = (e.clientX * speed) / 100;
                const y = (e.clientY * speed) / 100;

                setTimeout(() => {
                    circle.style.transform = `translate(${x}px, ${y}px)`;
                }, index * 100);
            });
        });

        const validationErrors = document.querySelectorAll('.validation-error');
        validationErrors.forEach(error => {
            if (error.textContent.trim()) {
                error.classList.add('show');
            }
        });

        const buttons = document.querySelectorAll('.btn-enhanced, .btn-secondary-enhanced');
        buttons.forEach(button => {
            button.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                const x = e.clientX - rect.left - size / 2;
                const y = e.clientY - rect.top - size / 2;

                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = x + 'px';
                ripple.style.top = y + 'px';
                ripple.style.position = 'absolute';
                ripple.style.borderRadius = '50%';
                ripple.style.backgroundColor = 'rgba(255, 255, 255, 0.3)';
                ripple.className = 'ripple-animation';
                ripple.style.pointerEvents = 'none';

                this.style.position = 'relative';
                this.style.overflow = 'hidden';
                this.appendChild(ripple);

                setTimeout(() => {
                    ripple.classList.add('active');
                }, 10);

                setTimeout(() => {
                    ripple.remove();
                }, 600);
            });
        });

        setInterval(() => {
            const circles = document.querySelectorAll('.floating-circle');
            circles.forEach((circle, index) => {
                const randomX = Math.sin(Date.now() * 0.001 * (index + 1)) * 10;
                const randomY = Math.cos(Date.now() * 0.0008 * (index + 1)) * 15;
                circle.style.transform = `translate(${randomX}px, ${randomY}px)`;
            });
        }, 3000);
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}