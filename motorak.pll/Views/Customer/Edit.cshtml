@using Motorak.BLL.ModelVM.Customer
@model EditCustomerModel
@{
    Layout = null;
}
<style>
    body {
        background-color: #1a001f;
        color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #e0c3ff;
    }

    .card-purple {
        background-color: #2a0044;
        border: 1px solid #5a00a3;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(90, 0, 163, 0.4);
        padding: 20px;
        margin-bottom: 20px;
        max-width: 800px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-purple:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(90, 0, 163, 0.6);
        }

    .card-header {
        font-size: 1.3rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 15px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }

    input {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #5a00a3;
        background-color: #35005c;
        color: white;
    }

        input::placeholder {
            color: #ccc;
        }

    button {
        background-color: #4b007d;
        border: none;
        padding: 10px 20px;
        color: white;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        button:hover {
            background-color: #5a00a3;
            transform: translateY(-2px);
        }
</style>

<h1>Edit Customer</h1>

<div class="card-purple">
    <div class="card-header">Edit Customer Info</div>
    <form asp-controller="Customer" asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" placeholder="Enter Name" />
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber">Phone</label>
            <input asp-for="PhoneNumber" placeholder="Enter Phone Number" />
        </div>

        <button type="submit">Update</button>
    </form>
</div>


