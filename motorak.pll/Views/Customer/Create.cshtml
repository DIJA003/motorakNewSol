@using Motorak.BLL.ModelVM.Customer
@model CreateCustomerModel
@{
    Layout = null;
}
<style>
    body {
        background-color: #1a001f;
        color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #e0c3ff;
    }

    .card-purple {
        background-color: #2a0044;
        border: 1px solid #5a00a3;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(90, 0, 163, 0.4);
        padding: 20px;
        margin: 20px auto;
        max-width: 600px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-purple:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(90, 0, 163, 0.6);
        }

    .card-header {
        font-size: 1.5rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 20px;
        text-align: center;
        border-bottom: 1px solid #5a00a3;
        padding-bottom: 10px;
    }

    input {
        width: 100%;
        padding: 10px;
        margin-bottom: 15px;
        border-radius: 8px;
        border: 1px solid #5a00a3;
        background-color: #35005c;
        color: white;
    }

        input::placeholder {
            color: #ccc;
        }

    button {
        background-color: #4b007d;
        border: none;
        padding: 10px 20px;
        color: white;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        button:hover {
            background-color: #5a00a3;
            transform: translateY(-2px);
        }
</style>

<h1>Create Customer</h1>

<div class="card-purple">
    <form asp-controller="Customer" asp-action="Create">
        <input asp-for="Name" placeholder="Enter Name" />
        <input asp-for="Email" type="email" placeholder="Enter Email" />
        <input asp-for="PhoneNumber" placeholder="Enter Phone Number" />
        <input asp-for="Password" type="password" placeholder="Enter Password" />
        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
        <button type="submit">Submit</button>
    </form>
</div>

