@using Motorak.BLL.ModelVM.Service
@using Motorak.DAL.Enums.SeviceEnums
@model ServiceDTO

@{
    ViewData["Title"] = "Delete Service";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container mt-5">
    <h1 class="mb-4 text-danger">Delete Service - ID @Model.ServiceId</h1>

    <div class="alert alert-warning shadow-sm">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Are you sure you want to delete the following service?
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">@Model.ServiceId</h5>
            <p class="card-text">@Model.Status.ToString()</p>
            <p>
                <strong>Status:</strong>
                @switch (Model.Status)
                {
                    case Status.Pending:
                        <span class="badge bg-warning text-dark">Pending</span>
                        break;
                    case Status.completed:
                        <span class="badge bg-success">Completed</span>
                        break;
                    case Status.cancelled:
                        <span class="badge bg-danger">Cancelled</span>
                        break;
                    default:
                        <span class="badge bg-secondary">Unknown</span>
                        break;
                }
            </p>
            <p><strong>Created Date:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="ServiceId" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Yes, Delete
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="bi bi-x-circle"></i> Cancel
        </a>
    </form>
</div>
