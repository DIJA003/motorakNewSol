@{
    ViewData["Title"] = "Our Cars";
    Layout = "~/Views/Shared/_MotorakIndex.cshtml";
}

<style>
    .cars-container {
        min-height: 100vh;
        background: var(--body-color);
        padding: 4rem 0;
    }

    .cars-hero {
        text-align: center;
        margin-bottom: 4rem;
    }

    .cars-title {
        font-size: var(--h1-font-size);
        color: var(--title-color);
        margin-bottom: 1rem;
    }

    .cars-subtitle {
        color: var(--text-color);
        font-size: var(--normal-font-size);
    }
</style>

<div class="cars-container">
    <div class="container">
        <div class="cars-hero">
            <h1 class="cars-title">
                <i class="ri-car-fill" style="color: var(--first-color); margin-right: 0.5rem;"></i>
                Premium Car Collection
            </h1>
            <p class="cars-subtitle">Discover our exclusive collection of luxury and performance vehicles</p>
        </div>

        <div class="featured__container container">
            <div class="featured__content grid">
                <article class="featured__card">
                    <div class="shape shape__smaller"></div>
                    <h1 class="featured__title">Tesla</h1>
                    <h3 class="featured__subtitle">Model S</h3>
                    <img src="/assets/img/featured1.png" alt="Tesla Model S" class="featured__img">
                    <h3 class="featured__price">$89,990</h3>
                    <button class="button featured__button">
                        <i class="ri-information-line"></i> View Details
                    </button>
                </article>

                <article class="featured__card">
                    <div class="shape shape__smaller"></div>
                    <h1 class="featured__title">BMW</h1>
                    <h3 class="featured__subtitle">i8</h3>
                    <img src="/assets/img/featured2.png" alt="BMW i8" class="featured__img">
                    <h3 class="featured__price">$147,500</h3>
                    <button class="button featured__button">
                        <i class="ri-information-line"></i> View Details
                    </button>
                </article>

                <article class="featured__card">
                    <div class="shape shape__smaller"></div>
                    <h1 class="featured__title">Audi</h1>
                    <h3 class="featured__subtitle">e-tron GT</h3>
                    <img src="/assets/img/featured3.png" alt="Audi e-tron GT" class="featured__img">
                    <h3 class="featured__price">$102,400</h3>
                    <button class="button featured__button">
                        <i class="ri-information-line"></i> View Details
                    </button>
                </article>
            </div>
        </div>
    </div>
</div>