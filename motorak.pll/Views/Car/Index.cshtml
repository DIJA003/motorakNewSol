@model List<Motorak.BLL.ModelVM.Car.CarListModel>
@using Motorak.DAL.Enums.CarEnums
@using motorak.dal.Enums.CarEnums

@{
    ViewData["Title"] = "Available Cars";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Available Cars</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
            <th>Daily Rent Price</th>
            <th>Mileage</th>
            <th>Status</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var car in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(car.ImagePath))
                        {
                            <img src="@Url.Content(car.ImagePath)" alt="@($"{car.Brand} {car.Model}")" width="120" height="80" style="object-fit:cover;" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>
                    <td>@car.Brand</td>
                    <td>@car.Model</td>
                    <td>@car.Year</td>
                    <td>
                        @if (car.Category == CarCategory.Buy)
                        {
                            @car.Price.ToString("C")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (car.Category == CarCategory.Rent && car.DailyRentPrice.HasValue)
                        {
                            @car.DailyRentPrice.Value.ToString("C")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@car.Mileage.ToString("N0") km</td>
                    <td>@car.Status</td>
                    <td>@car.Category</td>
                    <td>
                        <!-- Always show Add to Cart -->
                        <a asp-controller="Cart" asp-action="Add" asp-route-id="@car.Id" class="btn btn-sm btn-warning mb-1">Add to Cart</a>

                        <!-- Buy button for ForSale cars -->
                        @if (car.Category == CarCategory.Buy)
                        {
                            <a asp-controller="Purchase" asp-action="Buy" asp-route-id="@car.Id" class="btn btn-sm btn-success mb-1">Buy</a>
                        }

                        <!-- Rent button for ForRent cars -->
                        @if (car.Category == CarCategory.Rent)
                        {
                            <a asp-controller="Rent" asp-action="RentCar" asp-route-id="@car.Id" class="btn btn-sm btn-primary">Rent</a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center">No cars available.</td>
            </tr>
        }
    </tbody>
</table>
