@using Motorak.BLL.ModelVM.Purchases
@model PurchaseReadDto

@{
    ViewData["Title"] = "Purchase Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">📄 Purchase Details</h2>

    <div class="card shadow rounded">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Seller Name</dt>
                <dd class="col-sm-9">@Model.SellerName</dd>

                <dt class="col-sm-3">Payment Method</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>

                <dt class="col-sm-3">Total Price</dt>
                <dd class="col-sm-9">@Model.TotalPrice</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Edit
        </a>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}
