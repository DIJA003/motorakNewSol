@using Motorak.BLL.Helper
@inject IHttpContextAccessor HttpContextAccessor

<header class="header" id="header">
    <nav class="nav container">
        <a href="/" class="nav__logo">
            <i class="ri-steering-fill"></i>
            Motorak
        </a>
        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                <li class="nav__item">
                    <a asp-controller="Home" asp-action="Index" class="nav__link active-link">
                        <i class="ri-home-5-fill"></i> Home
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Service" asp-action="Index" class="nav__link">
                        <i class="ri-service-fill"></i> Services
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Mechanic" asp-action="Index" class="nav__link">
                        <i class="ri-tools-fill"></i> Mechanics
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Car" asp-action="Index" class="nav__link">
                        <i class="ri-car-fill"></i> Cars
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Cart/Index">
                        Cart (<span id="cart-count">@((HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<Motorak.DAL.Entites.CartItem>>("Cart")?.Sum(c => c.Quantity) ?? 0))</span>)
                    </a>
                </li>
            </ul>

            <partial name="_LoginPartial" />

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>
    </nav>
    <!--=============== SCROLL REVEAL - PAGE ANNIMATION ===============-->
    <script src="~/assets/js/scrollrevealAnimation.min.js"></script>

    <!--=============== SWIPER JS - PRODUCT SLIDER ===============-->
    <script src="~/assets/js/swiper-bundle.min.js"></script>

    <!--=============== MIXITUP JS - FILTER PRODUCT ===============-->
    <script src="~/assets/js/mixitup.min.js"></script>

    <!--=============== MAIN JS ===============-->
    <script src="~/assets/js/main.js"></script>
</header>
