@using Motorak.BLL.ModelVM.Car
@using Motorak.DAL.Enums.CarEnums
@using motorak.dal.Enums.CarEnums

@model CreateCarModel
@{
    ViewData["Title"] = "Add New Car";
}

<style>
    .create-car-container {
        background: var(--body-color);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .form-card {
        background: var(--container-color);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: none;
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .form-card-header {
        background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
        color: var(--white-color);
        padding: 1.5rem 2rem;
        border: none;
    }

    .form-card-body {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        color: var(--title-color);
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-control {
        background: rgba(var(--first-color-rgb), 0.05);
        border: 2px solid rgba(var(--first-color-rgb), 0.1);
        border-radius: 0.5rem;
        color: var(--text-color);
        padding: 0.75rem 1rem;
        font-size: var(--normal-font-size);
        transition: all 0.3s ease;
        width: 100%;
    }

        .form-control:focus {
            border-color: var(--first-color);
            box-shadow: 0 0 0 3px rgba(var(--first-color-rgb), 0.1);
            background: rgba(var(--first-color-rgb), 0.08);
            outline: none;
        }

    .form-select {
        background: rgba(var(--first-color-rgb), 0.05);
        border: 2px solid rgba(var(--first-color-rgb), 0.1);
        border-radius: 0.5rem;
        color: var(--text-color);
        padding: 0.75rem 1rem;
        font-size: var(--normal-font-size);
        transition: all 0.3s ease;
        width: 100%;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.5rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        padding-right: 2.5rem;
    }

        .form-select:focus {
            border-color: var(--first-color);
            box-shadow: 0 0 0 3px rgba(var(--first-color-rgb), 0.1);
            background-color: rgba(var(--first-color-rgb), 0.08);
            outline: none;
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
        border: none;
        color: var(--white-color);
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--first-color-alt), var(--first-color));
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(var(--first-color-rgb), 0.3);
            color: var(--white-color);
        }

    .btn-secondary {
        background: rgba(var(--first-color-rgb), 0.1);
        border: 2px solid rgba(var(--first-color-rgb), 0.2);
        color: var(--first-color);
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-secondary:hover {
            background: var(--first-color);
            color: var(--white-color);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(var(--first-color-rgb), 0.2);
        }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(var(--first-color-rgb), 0.1);
    }

    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .validation-summary {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.2);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 1.5rem;
            color: #dc3545;
        }

    .input-group {
        display: flex;
        gap: 1rem;
    }

        .input-group .form-group {
            flex: 1;
        }

</style>

<div class="create-car-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="form-card">
                    <div class="form-card-header">
                        <h3 class="mb-0">
                            <i class="ri-car-line me-2"></i>
                            Add New Car
                        </h3>
                        <p class="mb-0 mt-2 opacity-75">Fill in the details below to add a new car to the fleet</p>
                    </div>
                    <div class="form-card-body">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="validation-summary">
                                <h6><i class="ri-error-warning-line me-2"></i>Please correct the following errors:</h6>
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            </div>
                        }

                        <form asp-action="Create" method="post" enctype="multipart/form-data">
                            <div class="input-group">
                                <div class="form-group">
                                    <label asp-for="Brand" class="form-label">
                                        <i class="ri-car-line"></i>
                                        Brand
                                    </label>
                                    <input asp-for="Brand" class="form-control" placeholder="Enter car brand" />
                                    <span asp-validation-for="Brand" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Model" class="form-label">
                                        <i class="ri-roadster-line"></i>
                                        Model
                                    </label>
                                    <input asp-for="Model" class="form-control" placeholder="Enter car model" />
                                    <span asp-validation-for="Model" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="input-group">
                                <div class="form-group">
                                    <label asp-for="Year" class="form-label">
                                        <i class="ri-calendar-line"></i>
                                        Year
                                    </label>
                                    <input asp-for="Year" class="form-control" type="number" min="1900" max="2030" placeholder="Enter year" />
                                    <span asp-validation-for="Year" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Color" class="form-label">
                                        <i class="ri-palette-line"></i>
                                        Color
                                    </label>
                                    <input asp-for="Color" class="form-control" placeholder="Enter color" />
                                    <span asp-validation-for="Color" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="input-group">
                                <div class="form-group">
                                    <label asp-for="Mileage" class="form-label">
                                        <i class="ri-dashboard-line"></i>
                                        Mileage
                                    </label>
                                    <input asp-for="Mileage" class="form-control" type="number" min="0" placeholder="Enter mileage" />
                                    <span asp-validation-for="Mileage" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Price" class="form-label">
                                        <i class="ri-money-dollar-circle-line"></i>
                                        Price ($)
                                    </label>
                                    <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" placeholder="Enter price" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="input-group">
                                <div class="form-group">
                                    <label asp-for="Condition" class="form-label">
                                        <i class="ri-shield-check-line"></i>
                                        Condition
                                    </label>
                                    <select asp-for="Condition" class="form-select">
                                        <option value="">Select Condition</option>
                                        @foreach (CarCondition condition in Enum.GetValues<CarCondition>())
                                        {
                                            <option value="@condition">@condition</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Condition" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Transmission" class="form-label">
                                        <i class="ri-settings-line"></i>
                                        Transmission
                                    </label>
                                    <select asp-for="Transmission" class="form-select">
                                        <option value="">Select Transmission</option>
                                        @foreach (CarTransmission transmission in Enum.GetValues<CarTransmission>())
                                        {
                                            <option value="@transmission">@transmission</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Transmission" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="input-group">
                                <div class="form-group">
                                    <label asp-for="Type" class="form-label">
                                        <i class="ri-car-washing-line"></i>
                                        Car Type
                                    </label>
                                    <select asp-for="Type" class="form-select">
                                        <option value="">Select Car Type</option>
                                        @foreach (CarType type in Enum.GetValues<CarType>())
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Type" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Category" class="form-label">
                                        <i class="ri-price-tag-3-line"></i>
                                        Category
                                    </label>
                                    <select asp-for="Category" class="form-select">
                                        <option value="">Select Category</option>
                                        @foreach (CarCategory category in Enum.GetValues<CarCategory>())
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="DailyRentPrice" class="form-label">
                                    <i class="ri-calendar-check-line"></i>
                                    Daily Rent Price ($) - Optional
                                </label>
                                <input asp-for="DailyRentPrice" class="form-control" type="number" min="0" step="0.01" placeholder="Enter daily rent price (if applicable)" />
                                <span asp-validation-for="DailyRentPrice" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label for="imageFile" class="form-label">
                                    <i class="ri-image-line"></i>
                                    Car Image
                                </label>
                                <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                                <small class="text-muted">Upload an image of the car (optional)</small>
                            </div>

                            <div class="action-buttons">
                                <a asp-action="Index" class="btn-secondary">
                                    <i class="ri-arrow-left-line"></i>
                                    Cancel
                                </a>
                                <button type="submit" class="btn-primary">
                                    <i class="ri-save-line"></i>
                                    Add Car
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        
        document.addEventListener('DOMContentLoaded', function() {
            
            const inputs = document.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.style.transform = 'scale(1.02)';
                });

                input.addEventListener('blur', function() {
                    this.style.transform = 'scale(1)';
                });
            });

            const imageInput = document.getElementById('imageFile');
            if (imageInput) {
                imageInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        console.log('Image selected:', file.name);
                    }
                });
            }
        });
    </script>
}