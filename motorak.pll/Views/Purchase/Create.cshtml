@using Motorak.BLL.ModelVM.Purchases
@model PurchaseCreateDto

@{
    ViewData["Title"] = "Create Purchase";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">🛒 Create New Purchase</h2>

    <div class="card shadow rounded">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="SellerName" class="form-label fw-bold"></label>
                    <input asp-for="SellerName" class="form-control" placeholder="Enter Seller Name" />
                    <span asp-validation-for="SellerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label fw-bold"></label>
                    <input asp-for="PaymentMethod" class="form-control" placeholder="e.g., Credit Card, Cash" />
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CarId" class="form-label fw-bold"></label>
                    <input asp-for="CarId" class="form-control" type="number" readonly />
                    <span asp-validation-for="CarId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalPrice" class="form-label fw-bold"></label>
                    <input asp-for="TotalPrice" class="form-control" type="number" readonly />
                    <span asp-validation-for="TotalPrice" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerId" class="form-label fw-bold"></label>
                    <input asp-for="CustomerId" class="form-control" type="number" placeholder="Enter Customer ID" />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Motorak.DAL.Enums.TransactionEnums.TransactionStatus>()">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Save Purchase
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}
