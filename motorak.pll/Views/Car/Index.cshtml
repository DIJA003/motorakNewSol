@using Microsoft.AspNetCore.Identity
@using Motorak.DAL.Entites
@using motorak.dal.Entites
@using motorak.dal.Enums.CarEnums
@using Motorak.DAL.Enums.CarEnums

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@model IEnumerable<Motorak.BLL.ModelVM.Car.CarListModel>

@{
    ViewData["Title"] = "Our Fleet";
}

<section class="featured section" id="featured">
    <div class="container">
        <h2 class="section__title">
            Our Fleet of Cars
        </h2>

        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
        {
            <div class="admin-controls" style="text-align: center; margin-bottom: 3rem;">
                <a asp-action="Create" class="button admin-button">
                    <i class='ri-add-line'></i> Add New Car
                </a>
            </div>
        }

        <!-- Filter buttons like homepage -->
        <div class="featured__filters">
            <button class="featured__item active-featured filter-btn" data-filter="all">
                <span>All</span>
            </button>
            <button class="featured__item filter-btn" data-filter="forsale">
                <span>For Sale</span>
            </button>
            <button class="featured__item filter-btn" data-filter="forrent">
                <span>For Rent</span>
            </button>
            <button class="featured__item filter-btn" data-filter="available">
                <span>Available</span>
            </button>
        </div>

        <div class="featured__content grid car-grid">
            @foreach (var car in Model)
            {
                <article class="featured__card car-card mix"
                         data-category="@car.Category.ToString().ToLower()"
                         data-status="@car.Status.ToString().ToLower()">
                    <div class="shape shape__smaller"></div>

                    <div class="car-header">
                        <h1 class="featured__title">@car.Brand</h1>
                        <h3 class="featured__subtitle">@car.Model (@car.Year)</h3>
                    </div>

                    <div class="car-image-container">
                        <img src="@Url.Content(car.ImagePath ?? "~/assets/img/featured1.png")"
                             alt="@car.Brand @car.Model"
                             class="featured__img car-image">
                    </div>

                    <!-- Car specifications -->
                    <div class="car-specs">
                        <div class="spec-item">
                            <i class="ri-dashboard-2-line"></i>
                            <span>@car.Mileage.ToString("N0") km</span>
                        </div>
                        <div class="spec-item">
                            <i class="ri-calendar-line"></i>
                            <span>@car.Year</span>
                        </div>
                        <div class="spec-item">
                            <i class="ri-car-line"></i>
                            <span>@car.Category</span>
                        </div>
                        <div class="spec-item">
                            <i class="ri-checkbox-circle-line"></i>
                            <span>@car.Status</span>
                        </div>
                    </div>

                    <!-- Pricing -->
                    <div class="car-pricing">
                        <h3 class="featured__price">$@car.Price.ToString("N0")</h3>
                        @if (car.DailyRentPrice.HasValue)
                        {
                            <div class="rent-price">
                                <small>Rent: $@car.DailyRentPrice.Value.ToString("N0")/day</small>
                            </div>
                        }
                    </div>

                    <div class="car-actions">
                        <a asp-action="Details" asp-route-id="@car.Id" class="button car-details-btn">
                            <i class='ri-eye-line'></i> Details
                        </a>

                        @if (SignInManager.IsSignedIn(User) && car.Status == CarStatus.Available)
                        {
                            <div class="quick-actions">
                                @if (car.Category == CarCategory.ForSale)
                                {
                                    <button class="quick-btn buy-btn" onclick="addToCart(@car.Id, 'buy')" title="Add to Cart (Buy)">
                                        <i class='ri-shopping-cart-line'></i>
                                    </button>
                                }
                                @if (car.Category == CarCategory.ForRent)
                                {
                                    <button class="quick-btn rent-btn" onclick="addToCart(@car.Id, 'rent')" title="Add to Cart (Rent)">
                                        <i class='ri-calendar-line'></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <div class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@car.Id" class="admin-btn edit-btn">
                                <i class='ri-edit-line'></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@car.Id" class="admin-btn delete-btn">
                                <i class='ri-delete-bin-line'></i>
                            </a>

                        </div>
                    }

                    <!-- Status and Category badges -->
                    <div class="availability-badges">
                        <span class="badge category-badge category-@car.Category.ToString().ToLower()">
                            @car.Category.ToString().Replace("For", "For ")
                        </span>
                        <span class="badge status-badge status-@car.Status.ToString().ToLower()">
                            @car.Status
                        </span>
                    </div>
                </article>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-content">
                    <i class="ri-car-line empty-icon"></i>
                    <h3>No Cars Available</h3>
                    <p>There are currently no cars in our fleet. Check back soon!</p>
                    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="button">Add First Car</a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Cart notification -->
<div id="cart-notification" class="cart-notification">
    <div class="notification-content">
        <i class="ri-check-line"></i>
        <span id="notification-message">Item added to cart!</span>
    </div>
</div>

@* Anti-forgery token *@
<form style="display:none;">
    @Html.AntiForgeryToken()
</form>

<style>
    /* Enhanced car grid styling */
    .car-grid {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .car-card {
        position: relative;
        background-color: var(--container-color);
        padding: 2rem 1.5rem 1.5rem;
        border-radius: 1rem;
        overflow: hidden;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        min-height: 400px;
        display: flex;
        flex-direction: column;
    }

        .car-card:hover {
            transform: translateY(-10px);
            border-color: var(--first-color);
            box-shadow: 0 20px 40px rgba(66, 133, 244, 0.1);
        }

    .car-header {
        text-align: center;
        margin-bottom: 1rem;
    }

    .car-image-container {
        position: relative;
        text-align: center;
        margin: 1rem 0;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .car-image {
        width: 100%;
        max-width: 220px;
        height: 140px;
        object-fit: cover;
        border-radius: 0.5rem;
        transition: transform 0.3s ease;
    }

    .car-card:hover .car-image {
        transform: scale(1.05);
    }

    /* Car specifications */
    .car-specs {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
        margin: 1rem 0;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0.5rem;
    }

    .spec-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--small-font-size);
        color: var(--text-color);
    }

        .spec-item i {
            color: var(--first-color);
            font-size: 1rem;
            min-width: 16px;
        }

    /* Car pricing */
    .car-pricing {
        text-align: center;
        margin: 1rem 0;
    }

    .rent-price {
        margin-top: 0.25rem;
    }

        .rent-price small {
            color: var(--text-color);
            font-size: var(--smaller-font-size);
        }

    /* Car actions */
    .car-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 1rem;
    }

    .car-details-btn {
        flex: 1;
        margin-right: 1rem;
        text-align: center;
        padding: 0.75rem 1.5rem;
    }

    .quick-actions {
        display: flex;
        gap: 0.5rem;
    }

    .quick-btn {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1.1rem;
    }

    .buy-btn {
        background: var(--first-color);
        color: white;
    }

        .buy-btn:hover {
            background: var(--first-color-alt);
            transform: scale(1.1);
        }

    .rent-btn {
        background: #28a745;
        color: white;
    }

        .rent-btn:hover {
            background: #218838;
            transform: scale(1.1);
        }

    /* Admin actions */
    .admin-actions {
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: flex;
        gap: 0.5rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .car-card:hover .admin-actions {
        opacity: 1;
    }

    .admin-btn {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: white;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .edit-btn {
        background: #007bff;
    }

        .edit-btn:hover {
            background: #0056b3;
            transform: scale(1.1);
        }

    .delete-btn {
        background: #dc3545;
    }

        .delete-btn:hover {
            background: #c82333;
            transform: scale(1.1);
        }

    /* Availability badges */
    .availability-badges {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .badge {
        padding: 0.25rem 0.5rem;
        border-radius: 1rem;
        font-size: var(--smaller-font-size);
        font-weight: var(--font-medium);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Category badges */
    .category-forsale {
        background: var(--first-color);
        color: white;
    }

    .category-forrent {
        background: #28a745;
        color: white;
    }

    /* Status badges */
    .status-available {
        background: #28a745;
        color: white;
    }

    .status-sold {
        background: #dc3545;
        color: white;
    }

    .status-rented {
        background: #ffc107;
        color: #212529;
    }

    .status-undermaintenance {
        background: #6c757d;
        color: white;
    }

    /* Filter buttons */
    .featured__filters {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        min-width: 80px;
    }

        .filter-btn span {
            font-weight: var(--font-medium);
        }

    /* Admin controls */
    .admin-controls {
        margin-bottom: 2rem;
    }

    .admin-button {
        padding: 1rem 2rem;
        font-size: var(--normal-font-size);
        font-weight: var(--font-medium);
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-color);
    }

    .empty-content {
        max-width: 400px;
        margin: 0 auto;
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--first-color);
        margin-bottom: 1rem;
    }

    .empty-state h3 {
        color: var(--title-color);
        margin-bottom: 1rem;
    }

    .empty-state p {
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    /* Cart notification */
    .cart-notification {
        position: fixed;
        top: 100px;
        right: -300px;
        background: var(--first-color);
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 0.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        transition: right 0.3s ease;
        z-index: 1000;
    }

        .cart-notification.show {
            right: 20px;
        }

    .notification-content {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .notification-content i {
            font-size: 1.2rem;
        }

</style>

<script>
    // Filter functionality
    document.addEventListener('DOMContentLoaded', function() {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const carCards = document.querySelectorAll('.car-card');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                // Remove active class from all buttons
                filterBtns.forEach(b => b.classList.remove('active-featured'));
                // Add active class to clicked button
                this.classList.add('active-featured');

                const filter = this.getAttribute('data-filter');

                carCards.forEach(card => {
                    const category = card.getAttribute('data-category');
                    const status = card.getAttribute('data-status');

                    let show = false;

                    if (filter === 'all') {
                        show = true;
                    } else if (filter === 'forsale' && category === 'forsale') {
                        show = true;
                    } else if (filter === 'forrent' && category === 'forrent') {
                        show = true;
                    } else if (filter === 'available' && status === 'available') {
                        show = true;
                    }

                    if (show) {
                        card.style.display = 'flex';
                        card.style.animation = 'fadeIn 0.5s ease';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    });

    // Add to cart functionality
    function addToCart(carId, itemType) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        fetch('/Cart/AddToCartSimple', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token || ''
            },
            body: `id=${carId}&itemType=${itemType}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message || `Car ${itemType === 'rent' ? 'added for rental' : 'added to cart'} successfully!`);
                updateCartCount(data.count);
            } else {
                showNotification(data.message || 'Failed to add item to cart', 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showNotification('An error occurred. Please try again.', 'error');
        });
    }

    // Show notification
    function showNotification(message, type = 'success') {
        const notification = document.getElementById('cart-notification');
        const messageEl = document.getElementById('notification-message');

        messageEl.textContent = message;
        notification.classList.add('show');

        if (type === 'error') {
            notification.style.background = '#dc3545';
        } else {
            notification.style.background = 'var(--first-color)';
        }

        setTimeout(() => {
            notification.classList.remove('show');
        }, 3000);
    }

    // Update cart count (if you have a cart counter in header)
    function updateCartCount(count) {
        const cartCountEl = document.getElementById('cart-count');
        if (cartCountEl) {
            cartCountEl.textContent = count;
        }
    }

   
</script>