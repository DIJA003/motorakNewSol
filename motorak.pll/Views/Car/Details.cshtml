@using Motorak.BLL.ModelVM.Car;
@using Motorak.DAL.Enums.CarEnums;
@using motorak.dal.Enums.CarEnums;

@model CarDetailsModel
@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model} - Details";
}
@Html.AntiForgeryToken()

<style>
    .car-details-container {
        background: var(--body-color);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .detail-card {
        background: var(--container-color);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: none;
        margin-bottom: 2rem;
        overflow: hidden;
    }

    .detail-card-header {
        background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
        color: var(--white-color);
        padding: 1.5rem 2rem;
        border: none;
    }

    .detail-card-body {
        padding: 2rem;
    }

    .car-image {
        border-radius: 0.75rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease;
        max-height: 300px;
        width: 100%;
        object-fit: cover;
    }

        .car-image:hover {
            transform: scale(1.02);
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-available {
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .status-unavailable {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .category-badge {
        background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
        color: var(--white-color);
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(var(--first-color-rgb), 0.1);
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-weight: 600;
        color: var(--title-color);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .detail-value {
        color: var(--text-color);
        font-weight: 500;
    }

    .pricing-card {
        background: var(--container-color);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        border: none;
        position: sticky;
        top: 2rem;
    }

    .pricing-option {
        background: linear-gradient(135deg, rgba(var(--first-color-rgb), 0.05), rgba(var(--first-color-rgb), 0.1));
        border: 2px solid rgba(var(--first-color-rgb), 0.15);
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .pricing-option::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--first-color), var(--first-color-alt));
        }

        .pricing-option:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(var(--first-color-rgb), 0.2);
            border-color: var(--first-color);
        }

    .price-display {
        text-align: center;
        margin-bottom: 1rem;
    }

    .price-amount {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--first-color);
        margin-bottom: 0.25rem;
    }

    .price-period {
        color: var(--text-color);
        font-size: 0.875rem;
        opacity: 0.8;
    }

    .action-btn {
        border-radius: 0.5rem;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        text-decoration: none;
    }

    .btn-purchase {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }

        .btn-purchase:hover {
            background: linear-gradient(135deg, #059669, #047857);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
            color: white;
        }

    .btn-rent {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
    }

        .btn-rent:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
            color: white;
        }

    .btn-secondary-action {
        background: rgba(var(--first-color-rgb), 0.1);
        color: var(--first-color);
        border: 1px solid rgba(var(--first-color-rgb), 0.2);
        margin: 0.25rem 0;
    }

        .btn-secondary-action:hover {
            background: var(--first-color);
            color: var(--white-color);
            transform: translateY(-1px);
        }

    .cart-link {
        background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
        color: var(--white-color);
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .cart-link:hover {
            color: var(--white-color);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(var(--first-color-rgb), 0.3);
        }

    .cart-count {
        background: var(--white-color);
        color: var(--first-color);
        padding: 0.25rem 0.5rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        min-width: 1.5rem;
        text-align: center;
    }

    .alert-custom {
        border-radius: 0.75rem;
        border: none;
        padding: 1rem 1.5rem;
        font-weight: 500;
    }

    .alert-warning-custom {
        background: rgba(245, 158, 11, 0.1);
        color: #d97706;
        border-left: 4px solid #f59e0b;
    }

    .info-card {
        background: linear-gradient(135deg, rgba(var(--first-color-rgb), 0.05), rgba(var(--first-color-rgb), 0.02));
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-top: 1rem;
        border-left: 4px solid var(--first-color);
    }

        .info-card h6 {
            color: var(--first-color);
            font-weight: 700;
            margin-bottom: 1rem;
        }

    .info-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

        .info-list li {
            padding: 0.5rem 0;
            color: var(--text-color);
            font-size: 0.875rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
        }

            .info-list li::before {
                content: '✓';
                color: var(--first-color);
                font-weight: bold;
                flex-shrink: 0;
                margin-top: 0.1rem;
            }

    .specs-table {
        width: 100%;
        border-collapse: collapse;
    }

        .specs-table td {
            padding: 0.75rem 0;
            border-bottom: 1px solid rgba(var(--first-color-rgb), 0.1);
            vertical-align: top;
        }

            .specs-table td:first-child {
                font-weight: 600;
                color: var(--title-color);
                width: 40%;
            }

            .specs-table td:last-child {
                color: var(--text-color);
            }

    .notification {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        min-width: 300px;
        border-radius: 0.75rem;
        padding: 1rem 1.5rem;
        font-weight: 500;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        animation: slideInRight 0.3s ease-out;
    }

</style>

<div class="car-details-container">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="detail-card">
                    <div class="detail-card-header">
                        <div class="d-flex justify-content-between align-items-center flex-wrap">
                            <h3 class="mb-0">
                                <i class="ri-car-line me-2"></i>
                                @Model.Brand @Model.Model (@Model.Year)
                            </h3>
                            <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                                <span class="status-badge @(Model.Status == Motorak.DAL.Enums.CarEnums.CarStatus.Available ? "status-available" : "status-unavailable")">
                                    <i class="ri-checkbox-circle-line"></i>
                                    @Model.Status
                                </span>
                                <span class="category-badge">
                                    <i class="ri-price-tag-3-line me-1"></i>
                                    @Model.Category
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="detail-card-body">
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <img src="@(Model.ImagePath ?? "/images/default-car.jpg")"
                                     class="car-image" alt="@Model.Brand @Model.Model">
                            </div>
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="ri-information-line me-2"></i>
                                    Vehicle Details
                                </h5>

                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-car-line"></i>
                                        Brand
                                    </span>
                                    <span class="detail-value">@Model.Brand</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-roadster-line"></i>
                                        Model
                                    </span>
                                    <span class="detail-value">@Model.Model</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-calendar-line"></i>
                                        Year
                                    </span>
                                    <span class="detail-value">@Model.Year</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-palette-line"></i>
                                        Color
                                    </span>
                                    <span class="detail-value">@Model.Color</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-dashboard-line"></i>
                                        Mileage
                                    </span>
                                    <span class="detail-value">@Model.Mileage.ToString("N0") miles</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-settings-line"></i>
                                        Transmission
                                    </span>
                                    <span class="detail-value">@Model.Transmission</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-shield-check-line"></i>
                                        Condition
                                    </span>
                                    <span class="detail-value">@Model.Condition</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.OwnerName))
                                {
                                    <div class="detail-row">
                                        <span class="detail-label">
                                            <i class="ri-user-line"></i>
                                            Owner
                                        </span>
                                        <span class="detail-value">@Model.OwnerName</span>
                                    </div>
                                }
                                <div class="detail-row">
                                    <span class="detail-label">
                                        <i class="ri-time-line"></i>
                                        Date Added
                                    </span>
                                    <span class="detail-value">@Model.DateAdded.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="pricing-card">
                    <div class="detail-card-header">
                        <h5 class="mb-0">
                            <i class="ri-money-dollar-circle-line me-2"></i>
                            Pricing & Actions
                        </h5>
                    </div>
                    <div class="detail-card-body">
                        @if (Model.Status == Motorak.DAL.Enums.CarEnums.CarStatus.Available)
                        {
                            @if (Model.Category == CarCategory.ForSale || Model.Category == CarCategory.Both)
                            {
                                <div class="pricing-option">
                                    <h6 class="text-success mb-3">
                                        <i class="ri-shopping-cart-line me-2"></i>
                                        Purchase Option
                                    </h6>
                                    <div class="price-display">
                                        <div class="price-amount">$@Model.Price.ToString("N0")</div>
                                        <div class="price-period">One-time payment</div>
                                    </div>
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <button type="button" class="action-btn btn-purchase"
                                                onclick="addToCartDirect(@Model.Id, 'Buy')">
                                            <i class="ri-cart-plus-line"></i>
                                            Add to Cart (Buy)
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="/Identity/Account/Login" class="action-btn btn-purchase">
                                            <i class="ri-login-circle-line"></i>
                                            Login to Purchase
                                        </a>
                                    }
                                </div>
                            }

                            @if (Model.Category == CarCategory.ForRent || Model.Category == CarCategory.Both)
                            {
                                <div class="pricing-option">
                                    <h6 class="text-info mb-3">
                                        <i class="ri-calendar-line me-2"></i>
                                        Rental Option
                                    </h6>
                                    @if (Model.DailyRentPrice.HasValue)
                                    {
                                        <div class="price-display">
                                            <div class="price-amount">$@Model.DailyRentPrice.Value.ToString("N0")</div>
                                            <div class="price-period">per day</div>
                                        </div>
                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            <button type="button" class="action-btn btn-rent"
                                                    onclick="showAddToCartModal(@Model.Id, '@Model.Category')">
                                                <i class="ri-calendar-check-line"></i>
                                                Select Rental Dates
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="/Identity/Account/Login" class="action-btn btn-rent">
                                                <i class="ri-login-circle-line"></i>
                                                Login to Rent
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning-custom">
                                            <i class="ri-information-line me-2"></i>
                                            Rental pricing not available
                                        </div>
                                    }
                                </div>
                            }

                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="text-center mt-3">
                                    <a href="@Url.Action("Index", "Cart")" class="cart-link">
                                        <i class="ri-shopping-cart-line"></i>
                                        View Cart
                                        <span class="cart-count">0</span>
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning-custom">
                                <h6><i class="ri-error-warning-line me-2"></i>Not Available</h6>
                                <p class="mb-0">This vehicle is currently @Model.Status.ToString().ToLower().</p>
                            </div>
                        }

                        <!-- Additional Actions -->
                        <hr style="margin: 2rem 0; border-color: rgba(var(--first-color-rgb), 0.1);">
                        <div class="d-grid gap-2">
                            <button type="button" class="action-btn btn-secondary-action"
                                    onclick="shareVehicle()">
                                <i class="ri-share-line"></i>
                                Share Vehicle
                            </button>
                            <button type="button" class="action-btn btn-secondary-action"
                                    onclick="addToWishlist(@Model.Id)">
                                <i class="ri-heart-line"></i>
                                Add to Wishlist
                            </button>
                            <button type="button" class="action-btn btn-secondary-action"
                                    data-bs-toggle="modal" data-bs-target="#contactModal">
                                <i class="ri-mail-line"></i>
                                Contact Seller
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Additional Info Card -->
                <div class="info-card">
                    <h6>
                        <i class="ri-shield-check-line me-2"></i>
                        What's Included
                    </h6>
                    <ul class="info-list">
                        <li><strong>Free Inspection:</strong> Comprehensive vehicle inspection report</li>
                        <li><strong>30-Day Warranty:</strong> Limited warranty coverage included</li>
                        <li><strong>Financing Available:</strong> Multiple payment options for qualified buyers</li>
                        <li><strong>7-Day Returns:</strong> Return policy with conditions</li>
                        <li><strong>24/7 Support:</strong> Customer service whenever you need it</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Specifications Section -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="detail-card">
                    <div class="detail-card-header">
                        <h5 class="mb-0">
                            <i class="ri-settings-3-line me-2"></i>
                            Vehicle Specifications
                        </h5>
                    </div>
                    <div class="detail-card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <table class="specs-table">
                                    <tr>
                                        <td><i class="ri-flashlight-line me-2"></i><strong>Engine Type:</strong></td>
                                        <td>@Model.Type</td>
                                    </tr>
                                    <tr>
                                        <td><i class="ri-settings-line me-2"></i><strong>Transmission:</strong></td>
                                        <td>@Model.Transmission</td>
                                    </tr>
                                    <tr>
                                        <td><i class="ri-gas-station-line me-2"></i><strong>Fuel Type:</strong></td>
                                        <td>Gasoline</td>
                                    </tr>
                                    <tr>
                                        <td><i class="ri-car-line me-2"></i><strong>Body Style:</strong></td>
                                        <td>@Model.Type</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <table class="specs-table">
                                    <tr>
                                        <td><i class="ri-palette-line me-2"></i><strong>Exterior Color:</strong></td>
                                        <td>@Model.Color</td>
                                    </tr>
                                    <tr>
                                        <td><i class="ri-sofa-line me-2"></i><strong>Interior Color:</strong></td>
                                        <td>Black Leather</td>
                                    </tr>
                                    <tr>
                                        <td><i class="ri-steering-2-line me-2"></i><strong>Drivetrain:</strong></td>
                                        <td>Front Wheel Drive</td>
                                    </tr>
                                    <tr>
                                        <td><i class="ri-barcode-line me-2"></i><strong>VIN:</strong></td>
                                        <td>*****@Model.Id.ToString("D4")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact Modal -->
<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 1rem; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--first-color), var(--first-color-alt)); color: white; border-radius: 1rem 1rem 0 0;">
                <h5 class="modal-title" id="contactModalLabel">
                    <i class="ri-mail-line me-2"></i>
                    Contact Seller
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="ri-user-line me-2"></i>Your Name:
                        </label>
                        <input type="text" class="form-control" style="border-radius: 0.5rem; border: 2px solid rgba(var(--first-color-rgb), 0.1);" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="ri-mail-line me-2"></i>Email:
                        </label>
                        <input type="email" class="form-control" style="border-radius: 0.5rem; border: 2px solid rgba(var(--first-color-rgb), 0.1);" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="ri-phone-line me-2"></i>Phone Number:
                        </label>
                        <input type="tel" class="form-control" style="border-radius: 0.5rem; border: 2px solid rgba(var(--first-color-rgb), 0.1);">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="ri-message-3-line me-2"></i>Message:
                        </label>
                        <textarea class="form-control" rows="4" style="border-radius: 0.5rem; border: 2px solid rgba(var(--first-color-rgb), 0.1);"
                                  placeholder="I'm interested in the @Model.Brand @Model.Model..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border: none; padding: 0 2rem 2rem 2rem;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 0.5rem;">Cancel</button>
                <button type="button" class="btn" style="background: linear-gradient(135deg, var(--first-color), var(--first-color-alt)); color: white; border-radius: 0.5rem; border: none;">
                    <i class="ri-send-plane-line me-2"></i>Send Message
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Include the Add to Cart Modal -->
@Html.Partial("_AddToCartModal")

<!-- Anti-forgery token for AJAX requests -->
@Html.AntiForgeryToken()

<script>
    // Initialize cart functionality when page loads
    document.addEventListener('DOMContentLoaded', function() {
        updateCartCount();

        // Add event listeners for form inputs in modal
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.style.borderColor = 'var(--first-color)';
                this.style.boxShadow = '0 0 0 3px rgba(var(--first-color-rgb), 0.1)';
            });

            input.addEventListener('blur', function() {
                this.style.borderColor = 'rgba(var(--first-color-rgb), 0.1)';
                this.style.boxShadow = 'none';
            });
        });
    });

        async function addToCartDirect(carId, itemType) {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/Cart/AddToCartSimple', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${carId}&itemType=${itemType}`
            });

            const result = await response.json();

            if (result.success) {
                showNotification('Item added to cart successfully!', 'success');
                updateCartCount();
            } else {
                showNotification(result.message, 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification('Error adding item to cart', 'error');
        }
    }

    async function updateCartCount() {
        try {
            const response = await fetch('/Cart/GetCartCount');
            const data = await response.json();

            const countElements = document.querySelectorAll('.cart-count');
            countElements.forEach(el => {
                el.textContent = data.count;

                // Add animation when count changes
                if (data.count > 0) {
                    el.style.animation = 'bounce 0.5s ease';
                    setTimeout(() => {
                        el.style.animation = '';
                    }, 500);
                }
            });
        } catch (error) {
            console.error('Error updating cart count:', error);
        }
    }

    function showNotification(message, type = 'info') {
        // Remove existing notifications
        const existingNotifications = document.querySelectorAll('.notification');
        existingNotifications.forEach(notification => notification.remove());

        const notification = document.createElement('div');
        notification.className = `notification alert alert-${type === 'error' ? 'danger' : type === 'success' ? 'success' : 'info'}`;

        const iconMap = {
            success: 'ri-check-circle-line',
            error: 'ri-error-warning-line',
            info: 'ri-information-line'
        };

        notification.innerHTML = `
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="${iconMap[type]} me-2"></i>
                    <span>${message}</span>
                </div>
                <button type="button" class="btn-close btn-close-white" onclick="this.closest('.notification').remove()"></button>
            </div>
        `;

        document.body.appendChild(notification);

        // Auto-remove after 5 seconds
        setTimeout(() => {
            if (notification.parentElement) {
                notification.style.animation = 'slideInRight 0.3s ease-out reverse';
                setTimeout(() => notification.remove(), 300);
            }
        }, 5000);
    }

    function shareVehicle() {
        if (navigator.share) {
            navigator.share({
                title: '@Model.Brand @Model.Model (@Model.Year)',
                text: 'Check out this amazing vehicle on Motorak!',
                url: window.location.href
            }).then(() => {
                showNotification('Vehicle shared successfully!', 'success');
            }).catch(() => {
                fallbackShare();
            });
        } else {
            fallbackShare();
        }
    }

    function fallbackShare() {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href).then(() => {
                showNotification('Link copied to clipboard!', 'success');
            }).catch(() => {
                showNotification('Unable to copy link', 'error');
            });
        } else {
            showNotification('Share feature not supported', 'error');
        }
    }

    function addToWishlist(carId) {
        // Simulate adding to wishlist (implement actual functionality as needed)
        showNotification('Vehicle added to wishlist!', 'success');

        // Change the heart icon temporarily
        const heartButton = event.target.closest('button');
        const heartIcon = heartButton.querySelector('i');
        heartIcon.className = 'ri-heart-fill';
        heartButton.style.color = '#ef4444';

        setTimeout(() => {
            heartIcon.className = 'ri-heart-line';
            heartButton.style.color = '';
        }, 2000);
    }

    function showAddToCartModal(carId, category) {
        // This function should trigger your existing add to cart modal
        // Implementation depends on your modal structure
        console.log('Show rental modal for car:', carId, 'category:', category);
        showNotification('Please select rental dates to continue', 'info');
    }
</script>

