@using Motorak.BLL.Helper
@inject IHttpContextAccessor HttpContextAccessor

<header class="header" id="header">
    <nav class="nav container">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__logo">
            <i class="ri-steering-fill"></i>
            @SharedLocalizer["Motorak"]
        </a>
        <div class="nav__menu" id="nav-menu">
            <ul class="nav__list">
                <li class="nav__item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav__link">@SharedLocalizer["Home"]</a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Service" asp-action="Index" class="nav__link">
                        <i class="ri-service-fill"></i> @SharedLocalizer["Services"]
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Mechanic" asp-action="Index" class="nav__link">
                        <i class="ri-tools-fill"></i> @SharedLocalizer["Mechanics"]
                    </a>
                </li>
                <li class="nav__item">
                    <a asp-controller="Car" asp-action="Index" class="nav__link">
                        <i class="ri-car-fill"></i> @SharedLocalizer["Cars"]
                    </a>
                </li>
                @* <li class="nav-item">
                    <a class="nav-link" href="/Cart/Index">
                        @SharedLocalizer["Cart"] (<span id="cart-count">@((HttpContextAccessor.HttpContext?.Session.GetObjectFromJson<List<Motorak.DAL.Entites.CartItem>>("Cart")?.Sum(c => c.Quantity) ?? 0))</span>)
                    </a>
                </li> *@
            </ul>

            <partial name="_LoginPartial" />

            <div class="nav__close" id="nav-close">
                <i class="ri-close-line"></i>
            </div>
        </div>

        <div class="nav__toggle" id="nav-toggle">
            <i class="ri-menu-line"></i>
        </div>
    </nav>
     <a class="dropdown-item d-flex justify-content-between"
        href="@Url.Action("SetLanguage", "Home", new {
                        culture = "en-US",
                        returnUrl = Context.Request.Path + Context.Request.QueryString
                    })">
        <img src="~/assets/img/US_Flag.png" width="25" height="15" class="mt-1" />
        <span>English</span>
    </a>
    <a class="dropdown-item d-flex justify-content-between"
        href="@Url.Action("SetLanguage", "Home", new {
                        culture = "ar-EG",
                        returnUrl = Context.Request.Path + Context.Request.QueryString
                    })">
        <img src="~/assets/img/EG_Flag.png" width="25" height="15" class="mt-1" />
        <span>Arabic</span>
    </a>







    <!--=============== SCROLL REVEAL - PAGE ANNIMATION ===============-->
    <script src="~/assets/js/scrollrevealAnimation.min.js"></script>

    <!--=============== SWIPER JS - PRODUCT SLIDER ===============-->
    <script src="~/assets/js/swiper-bundle.min.js"></script>

    <!--=============== MIXITUP JS - FILTER PRODUCT ===============-->
    <script src="~/assets/js/mixitup.min.js"></script>

    <!--=============== MAIN JS ===============-->
    <script src="~/assets/js/main.js"></script>
</header>
