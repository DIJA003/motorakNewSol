@using Microsoft.AspNetCore.Identity
@using Motorak.DAL.Entites
@using motorak.dal.Entites
@using motorak.dal.Enums.CarEnums
@using Motorak.DAL.Enums.CarEnums

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@model Motorak.BLL.ModelVM.Car.CarDetailsModel

@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model}";
}

<section class="car-details section">
    <div class="container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <a asp-controller="Home" asp-action="Index" class="breadcrumb-link">
                <i class="ri-home-line"></i> Home
            </a>
            <span class="breadcrumb-separator"><i class="ri-arrow-right-s-line"></i></span>
            <a asp-controller="Car" asp-action="Index" class="breadcrumb-link">Cars</a>
            <span class="breadcrumb-separator"><i class="ri-arrow-right-s-line"></i></span>
            <span class="breadcrumb-current">@Model.Brand @Model.Model</span>
        </nav>

        <div class="car-details__container">
            <!-- Car Image Section -->
            <div class="car-image-section">
                <div class="main-image-container">
                    <div class="shape shape__smaller"></div>
                    <img src="@Url.Content(Model.ImagePath ?? "~/assets/img/featured1.png")"
                         alt="@Model.Brand @Model.Model"
                         class="main-car-image"
                         id="mainImage">

                    <!-- Status badges -->
                    <div class="status-badges">
                        <span class="status-badge category-badge category-@Model.Category.ToString().ToLower()">
                            <i class="@(Model.Category == CarCategory.ForSale ? "ri-shopping-bag-line" : "ri-calendar-line")"></i>
                            @Model.Category.ToString().Replace("For", "For ")
                        </span>
                        <span class="status-badge car-status status-@Model.Status.ToString().ToLower()">
                            <i class="ri-checkbox-circle-line"></i> @Model.Status
                        </span>
                    </div>
                </div>

                <!-- Thumbnail gallery (if multiple images available) -->
                <div class="image-gallery">
                    <div class="thumbnail active" onclick="changeImage(this, '@Url.Content(Model.ImagePath ?? "~/assets/img/featured1.png")')">
                        <img src="@Url.Content(Model.ImagePath ?? "~/assets/img/featured1.png")" alt="Main view">
                    </div>
                    <!-- Add more thumbnails here if you have multiple images -->
                </div>
            </div>

            <!-- Car Information Section -->
            <div class="car-info-section">
                <div class="car-header">
                    <h1 class="car-title">@Model.Brand <span class="car-model">@Model.Model</span></h1>
                    <div class="car-year">@Model.Year Model</div>
                    <div class="car-pricing">
                        <div class="price-section">
                            <span class="price-label">Purchase Price:</span>
                            <span class="price-value">$@Model.Price.ToString("N0")</span>
                        </div>
                        @if (Model.DailyRentPrice.HasValue)
                        {
                            <div class="rent-price-section">
                                <span class="rent-price-label">Daily Rental:</span>
                                <span class="rent-price-value">$@Model.DailyRentPrice.Value.ToString("N0")/day</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Car Specifications -->
                <div class="specifications">
                    <h3 class="spec-title">
                        <i class="ri-settings-line"></i> Specifications
                    </h3>
                    <div class="spec-grid">
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="ri-dashboard-2-line"></i>
                            </div>
                            <div class="spec-content">
                                <span class="spec-label">Mileage</span>
                                <span class="spec-value">@Model.Mileage.ToString("N0") km</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="ri-car-line"></i>
                            </div>
                            <div class="spec-content">
                                <span class="spec-label">Vehicle Type</span>
                                <span class="spec-value">@Model.Type</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="ri-speed-line"></i>
                            </div>
                            <div class="spec-content">
                                <span class="spec-label">Transmission</span>
                                <span class="spec-value">@Model.Transmission</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="ri-calendar-line"></i>
                            </div>
                            <div class="spec-content">
                                <span class="spec-label">Year</span>
                                <span class="spec-value">@Model.Year</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="ri-palette-line"></i>
                            </div>
                            <div class="spec-content">
                                <span class="spec-label">Color</span>
                                <span class="spec-value">@Model.Color</span>
                            </div>
                        </div>
                        <div class="spec-item">
                            <div class="spec-icon">
                                <i class="ri-tools-line"></i>
                            </div>
                            <div class="spec-content">
                                <span class="spec-label">Condition</span>
                                <span class="spec-value">@Model.Condition</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Information -->
                <div class="additional-info">
                    <h3 class="info-title">
                        <i class="ri-information-line"></i> Additional Information
                    </h3>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Date Added:</span>
                            <span class="info-value">@Model.DateAdded.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Category:</span>
                            <span class="info-value">@Model.Category.ToString().Replace("For", "For ")</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Current Status:</span>
                            <span class="info-value status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.OwnerName))
                        {
                            <div class="info-item">
                                <span class="info-label">Owner:</span>
                                <span class="info-value">@Model.OwnerName</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Action Buttons -->
                @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Customer") || User.IsInRole("Mechanc")) && Model.Status == CarStatus.Available)
                {
                    <div class="action-section">
                        <h3 class="action-title">
                            <i class="ri-shopping-cart-line"></i> Take Action
                        </h3>
                        <div class="action-buttons">
                            @if (Model.Category == CarCategory.ForSale || Model.Category == CarCategory.Buy)
                            {
                                <button class="action-btn buy-btn" onclick="addToCart(@Model.Id, 'buy')">
                                    <i class="ri-shopping-bag-line"></i>
                                    <div class="btn-content">
                                        <span>Add to Cart (Purchase)</span>
                                        <small>Buy this vehicle for $@Model.Price.ToString("N0")</small>
                                    </div>
                                </button>
                            }
                            @if ((Model.Category == CarCategory.ForRent || Model.Category == CarCategory.Rent) && Model.DailyRentPrice.HasValue)
                            {
                                <button class="action-btn rent-btn" onclick="showRentModal()">
                                    <i class="ri-calendar-line"></i>
                                    <div class="btn-content">
                                        <span>Rent This Car</span>
                                        <small>$@Model.DailyRentPrice.Value.ToString("N0") per day - Select rental dates</small>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }
                else if (SignInManager.IsSignedIn(User) && Model.Status != CarStatus.Available)
                {
                    <div class="unavailable-section">
                        <h3 class="unavailable-title">
                            <i class="ri-close-circle-line"></i> Currently Unavailable
                        </h3>
                        <p class="unavailable-message">
                            This car is currently <strong>@Model.Status.ToString().ToLower()</strong> and not available for purchase or rental.
                        </p>
                    </div>
                }
                else if (!SignInManager.IsSignedIn(User))
                {
                    <div class="auth-prompt">
                        <h3>Want to purchase or rent this car?</h3>
                        <p>Please sign in to add items to your cart or make a rental.</p>
                        <div class="auth-buttons">
                            <a href="/Identity/Account/Login" class="button">Sign In</a>
                            <a href="/Identity/Account/Register" class="button button-outline">Create Account</a>
                        </div>
                    </div>
                }

                <!-- Admin Actions -->
                @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                {
                    <div class="admin-section">
                        <h3 class="admin-title">
                            <i class="ri-admin-line"></i> Admin Actions
                        </h3>
                        <div class="admin-buttons">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-btn edit-btn">
                                <i class="ri-edit-line"></i> Edit Car
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="admin-btn delete-btn"
                               onclick="return confirm('Are you sure you want to delete this car?')">
                                <i class="ri-delete-bin-line"></i> Delete Car
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
        i
        <!-- Back to Fleet Button -->
        <div class="back-section">
            <a asp-controller="Car" asp-action="Index" class="back-btn">
                <i class="ri-arrow-left-line"></i> Back to Fleet
            </a>
        </div>
    </div>
</section>

<!-- Rent Modal -->
@if (Model.Category == CarCategory.ForRent && Model.DailyRentPrice.HasValue && SignInManager.IsSignedIn(User) && Model.Status == CarStatus.Available)
{
    <div id="rentModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Rent @Model.Brand @Model.Model</h3>
                <span class="close" onclick="closeRentModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="rentForm">
                    <div class="form-group">
                        <label for="startDate">Start Date:</label>
                        <input type="date" id="startDate" name="startDate" required
                               min="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="form-group">
                        <label for="endDate">End Date:</label>
                        <input type="date" id="endDate" name="endDate" required
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")">
                    </div>
                    <div class="rental-summary">
                        <div class="summary-item">
                            <span>Daily Rate:</span>
                            <span>$@Model.DailyRentPrice.Value.ToString("N2")</span>
                        </div>
                        <div class="summary-item">
                            <span>Number of Days:</span>
                            <span id="numberOfDays">0</span>
                        </div>
                        <div class="summary-item total">
                            <span>Total Cost:</span>
                            <span id="totalCost">$0.00</span>
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="button button-outline" onclick="closeRentModal()">Cancel</button>
                        <button type="submit" class="button">Add to Cart</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Notification -->
<div id="notification" class="notification">
    <div class="notification-content">
        <i class="ri-check-line"></i>
        <span id="notification-message">Success!</span>
    </div>
</div>

@* Anti-forgery token *@
<form style="display:none;">
    @Html.AntiForgeryToken()
</form>

<style>
    /* Car Details Styling */
    .car-details {
        padding: 2rem 0;
        min-height: calc(100vh - var(--header-height));
    }

    /* Breadcrumb */
    .breadcrumb {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
        font-size: var(--small-font-size);
    }

    .breadcrumb-link {
        color: var(--text-color);
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .breadcrumb-link:hover {
            color: var(--first-color);
        }

    .breadcrumb-separator {
        color: var(--text-color-light);
        margin: 0 0.5rem;
    }

    .breadcrumb-current {
        color: var(--first-color);
        font-weight: var(--font-medium);
    }

    /* Main Container */
    .car-details__container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        margin-bottom: 3rem;
    }

    /* Image Section */
    .car-image-section {
        position: relative;
    }

    .main-image-container {
        position: relative;
        background: var(--container-color);
        border-radius: 1rem;
        padding: 2rem;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .main-car-image {
        width: 100%;
        height: 300px;
        object-fit: cover;
        border-radius: 0.5rem;
        transition: transform 0.3s ease;
    }

    .main-image-container:hover .main-car-image {
        transform: scale(1.05);
    }

    .status-badges {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        font-size: var(--small-font-size);
        font-weight: var(--font-medium);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        backdrop-filter: blur(10px);
    }

    /* Category badges */
    .category-forsale {
        background: rgba(66, 133, 244, 0.9);
        color: white;
    }

    .category-forrent {
        background: rgba(40, 167, 69, 0.9);
        color: white;
    }

    /* Status badges */
    .car-status.status-available {
        background: rgba(40, 167, 69, 0.9);
        color: white;
    }

    .car-status.status-sold {
        background: rgba(220, 53, 69, 0.9);
        color: white;
    }

    .car-status.status-rented {
        background: rgba(255, 193, 7, 0.9);
        color: #212529;
    }

    .car-status.status-undermaintenance {
        background: rgba(108, 117, 125, 0.9);
        color: white;
    }

    .image-gallery {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding: 0.5rem 0;
    }

    .thumbnail {
        flex-shrink: 0;
        width: 80px;
        height: 60px;
        border-radius: 0.5rem;
        overflow: hidden;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .thumbnail:hover,
        .thumbnail.active {
            border-color: var(--first-color);
            transform: scale(1.05);
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Car Info Section */
    .car-info-section {
        padding: 1rem 0;
    }

    .car-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .car-title {
        font-size: var(--h1-font-size);
        color: var(--title-color);
        margin-bottom: 0.5rem;
    }

    .car-model {
        color: var(--first-color);
    }

    .car-year {
        font-size: var(--h3-font-size);
        color: var(--text-color);
        margin-bottom: 1rem;
    }

    .car-pricing {
        margin-bottom: 1rem;
    }

    .price-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .price-label {
        font-size: var(--normal-font-size);
        color: var(--text-color);
    }

    .price-value {
        font-size: var(--h2-font-size);
        color: var(--first-color);
        font-weight: var(--font-semi-bold);
    }

    .rent-price-section {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .rent-price-label {
        font-size: var(--small-font-size);
        color: var(--text-color);
    }

    .rent-price-value {
        font-size: var(--normal-font-size);
        color: #28a745;
        font-weight: var(--font-medium);
    }

    /* Specifications */
    .specifications {
        margin-bottom: 2rem;
    }

    .spec-title,
    .info-title,
    .action-title,
    .admin-title,
    .unavailable-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--h3-font-size);
        color: var(--title-color);
        margin-bottom: 1rem;
    }

        .spec-title i,
        .info-title i,
        .action-title i,
        .admin-title i {
            color: var(--first-color);
        }

        .unavailable-title i {
            color: #dc3545;
        }

    .spec-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .spec-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--container-color);
        border-radius: 0.5rem;
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .spec-item:hover {
            border-color: var(--first-color);
            transform: translateY(-2px);
        }

    .spec-icon {
        width: 40px;
        height: 40px;
        background: var(--first-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .spec-content {
        display: flex;
        flex-direction: column;
    }

    .spec-label {
        font-size: var(--small-font-size);
        color: var(--text-color);
    }

    .spec-value {
        font-size: var(--normal-font-size);
        color: var(--title-color);
        font-weight: var(--font-medium);
    }

    /* Additional Information */
    .additional-info {
        margin-bottom: 2rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        padding: 1rem;
        background: var(--container-color);
        border-radius: 0.5rem;
        border-left: 4px solid var(--first-color);
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .info-label {
        font-size: var(--small-font-size);
        color: var(--text-color);
        font-weight: var(--font-medium);
    }

    .info-value {
        font-size: var(--normal-font-size);
        color: var(--title-color);
    }

        .info-value.status-available {
            color: #28a745;
        }

        .info-value.status-sold {
            color: #dc3545;
        }

        .info-value.status-rented {
            color: #ffc107;
        }

        .info-value.status-undermaintenance {
            color: #6c757d;
        }

    /* Action Section */
    .action-section {
        margin-bottom: 2rem;
    }

    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .action-btn {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        border: none;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: left;
        color: white;
        font-weight: var(--font-medium);
    }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

    .buy-btn {
        background: linear-gradient(135deg, var(--first-color), var(--first-color-alt));
    }

    .rent-btn {
        background: linear-gradient(135deg, #28a745, #20c997);
    }

    .action-btn i {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .btn-content {
        display: flex;
        flex-direction: column;
    }

        .btn-content span {
            font-size: var(--normal-font-size);
        }

        .btn-content small {
            opacity: 0.9;
            font-size: var(--small-font-size);
            margin-top: 0.25rem;
        }

    /* Unavailable Section */
    .unavailable-section {
        padding: 2rem;
        background: var(--container-color);
        border-radius: 1rem;
        border: 2px solid #dc3545;
        text-align: center;
        margin-bottom: 2rem;
    }

    .unavailable-message {
        color: var(--text-color);
        line-height: 1.6;
        margin: 0;
    }

    /* Auth Prompt */
    .auth-prompt {
        text-align: center;
        padding: 2rem;
        background: var(--container-color);
        border-radius: 1rem;
        border: 2px dashed var(--first-color);
        margin-bottom: 2rem;
    }

        .auth-prompt h3 {
            color: var(--title-color);
            margin-bottom: 1rem;
        }

        .auth-prompt p {
            color: var(--text-color);
            margin-bottom: 1.5rem;
        }

    .auth-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }

    .button-outline {
        background: transparent;
        border: 2px solid var(--first-color);
        color: var(--first-color);
    }

        .button-outline:hover {
            background: var(--first-color);
            color: white;
        }

    /* Admin Section */
    .admin-section {
        padding: 1.5rem;
        background: var(--container-color);
        border-radius: 1rem;
        border: 2px solid #dc3545;
    }

    .admin-buttons {
        display: flex;
        gap: 1rem;
    }

    .admin-btn {
        flex: 1;
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: var(--font-medium);
        transition: all 0.3s ease;
    }

    .edit-btn {
        background: #007bff;
        color: white;
    }

        .edit-btn:hover {
            background: #0056b3;
            transform: translateY(-2px);
        }

    .delete-btn {
        background: #dc3545;
        color: white;
    }

        .delete-btn:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

    /* Back Section */
    .back-section {
        text-align: center;
        margin-top: 2rem;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        background: var(--container-color);
        color: var(--text-color);
        text-decoration: none;
        border-radius: 0.5rem;
        border: 2px solid var(--text-color-light);
        transition: all 0.3s ease;
    }

        .back-btn:hover {
            border-color: var(--first-color);
            color: var(--first-color);
            transform: translateY(-2px);
        }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background-color: var(--container-color);
        margin: 10% auto;
        padding: 0;
        border-radius: 1rem;
        width: 90%;
        max-width: 500px;
        animation: modalSlideIn 0.3s ease;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
