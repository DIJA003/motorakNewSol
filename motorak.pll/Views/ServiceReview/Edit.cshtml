@model Motorak.BLL.ModelVM.ServiceReview.UpdateServiceReviewVM

@{
    ViewData["Title"] = "Edit Service Review";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Service Review</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        /* --- Background Gradient & Floating Shapes --- */
        body {
            background: linear-gradient(-45deg, #0a0a15, #1a1a2e, #16213e, #0f3460, #533483, #6a4c93);
            background-size: 600% 600%;
            background-attachment: fixed;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        .floating-elements {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .floating-shape {
            position: absolute;
            opacity: 0.1;
            border-radius: 50%;
            background: linear-gradient(45deg, #8a2be2, #9966cc);
        }

        .shape-1 {
            width: 100px;
            height: 100px;
            top: 10%;
            left: 10%;
            transform: rotate(45deg);
        }

        .shape-2 {
            width: 60px;
            height: 60px;
            top: 20%;
            right: 15%;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
        }

        .shape-3 {
            width: 80px;
            height: 80px;
            bottom: 20%;
            left: 20%;
            border-radius: 0;
            transform: rotate(30deg);
        }

        /* --- Card & Form Styles --- */
        .container {
            margin-top: 8rem;
            position: relative;
            z-index: 2;
        }

        .card {
            border: none;
            border-radius: 30px;
            backdrop-filter: blur(25px) saturate(180%);
            background: rgba(42, 42, 62, 0.15);
            overflow: hidden;
            transform: translateY(0);
            transition: all 0.4s cubic-bezier(0.23,1,0.32,1);
            position: relative;
        }

            .card:hover {
                transform: translateY(-8px) scale(1.02);
            }

        .card-header {
            background: linear-gradient(135deg, #8a2be2, #9966cc, #ba55d3);
            border: none;
            padding: 2.5rem;
            position: relative;
            overflow: hidden;
        }

            .card-header h4 {
                margin: 0;
                font-weight: 700;
                color: white;
                text-shadow: 0 2px 10px rgba(0,0,0,0.5);
                font-size: 1.5rem;
                position: relative;
                z-index: 1;
            }

        .card-body {
            padding: 3rem;
            background: rgba(20,20,35,0.4);
            position: relative;
        }

        .form-label {
            font-weight: 700;
            color: #f0f0f5;
            margin-bottom: 1rem;
            display: block;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
        }

        .form-control {
            border: 2px solid rgba(138,43,226,0.2);
            border-radius: 15px;
            padding: 1rem 1.5rem;
            background: rgba(20,20,35,0.6);
            color: #f0f0f5;
            font-size: 1rem;
            resize: vertical;
            min-height: 120px;
        }

            .form-control:focus {
                border-color: #8a2be2;
                box-shadow: 0 0 0 4px rgba(138,43,226,0.15);
            }

        /* --- Buttons --- */
        .btn {
            border-radius: 30px;
            padding: 1rem 2rem;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0.5rem;
            border: 2px solid transparent;
            transition: all 0.4s;
            position: relative;
            overflow: hidden;
        }

        .btn-success {
            background: linear-gradient(135deg,#8a2be2,#9966cc,#ba55d3);
            color: white;
        }

            .btn-success:hover {
                background: linear-gradient(135deg,#9932cc,#8a2be2,#9966cc);
            }

        .btn-secondary {
            background: linear-gradient(135deg,#4a4a6a,#3a3a5a,#2a2a4a);
            color: #e0e0e0;
        }

        /* --- Star Rating --- */
        #starRating {
            margin-bottom: 2rem;
            text-align: center;
        }

            #starRating i {
                cursor: pointer;
                margin: 0 8px;
                transition: all 0.4s;
                color: #8a2be2;
            }

                #starRating i:hover {
                    transform: scale(1.4) rotate(10deg);
                }
    </style>
</head>
<body>
    <!-- Floating Shapes -->
    <div class="floating-elements">
        <div class="floating-shape shape-1"></div>
        <div class="floating-shape shape-2"></div>
        <div class="floating-shape shape-3"></div>
    </div>

    <div class="container py-5">
        <div class="card shadow-lg">
            <div class="card-header">
                <h4><i class="bi bi-pencil"></i> Edit Service Review</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" id="reviewForm">
                    <input asp-for="ReviewId" type="hidden" />

                    <!-- Star Rating -->
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <div id="starRating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= Model.Rating ? "bi-star-fill" : "bi-star") fs-4" data-value="@i"></i>
                            }
                        </div>
                        <input asp-for="Rating" type="hidden" id="ratingValue" value="@Model.Rating" />
                    </div>

                    <!-- Comments -->
                    <div class="mb-3">
                        <label asp-for="Comments" class="form-label"></label>
                        <textarea asp-for="Comments" class="form-control"></textarea>
                        <span class="text-danger" asp-validation-for="Comments"></span>
                    </div>

                    <!-- Buttons -->
                    <button type="submit" class="btn btn-success me-2">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Star rating functionality
        const stars = document.querySelectorAll('#starRating i');
        const ratingInput = document.getElementById('ratingValue');

        stars.forEach(star => {
            star.addEventListener('click', () => {
                const val = parseInt(star.dataset.value);
                ratingInput.value = val;

                stars.forEach((s, idx) => {
                    if (idx < val) s.classList.replace('bi-star','bi-star-fill');
                    else s.classList.replace('bi-star-fill','bi-star');
                });
            });
        });

        // Initialize stars on load
        window.addEventListener('load', () => {
            const val = parseInt(ratingInput.value);
            stars.forEach((s, idx) => {
                if(idx < val) s.classList.replace('bi-star','bi-star-fill');
                else s.classList.replace('bi-star-fill','bi-star');
            });
        });

        // Floating particles effect
        function createParticle() {
            const p = document.createElement('div');
            p.style.position = 'fixed';
            p.style.width = p.style.height = Math.random()*8+4 + 'px';
            p.style.background = `linear-gradient(45deg, rgba(138,43,226,${Math.random()*0.8+0.2}), rgba(186,85,211,${Math.random()*0.6+0.3}))`;
            p.style.borderRadius = '50%';
            p.style.left = Math.random() * window.innerWidth + 'px';
            p.style.top = window.innerHeight + 'px';
            p.style.pointerEvents = 'none';
            p.style.zIndex = '1000';
            document.body.appendChild(p);

            let pos = window.innerHeight;
            const speed = Math.random()*4+2;
            const drift = Math.random()*4-2;

            function move() {
                pos -= speed;
                p.style.top = pos + 'px';
                p.style.left = (parseInt(p.style.left)+drift+Math.sin(pos*0.01)*3) + 'px';
                p.style.opacity = Math.max(0,1-((window.innerHeight-pos)/window.innerHeight));
                if(pos<-20) p.remove();
                else requestAnimationFrame(move);
            }
            move();
        }
        setInterval(createParticle,200);

        // Save animation
        const form = document.getElementById('reviewForm');
        form.addEventListener('submit', e => {
            const btn = form.querySelector('button[type="submit"]');
            btn.innerHTML = '<i class="bi bi-check-circle"></i> Saved!';
            btn.style.background = 'linear-gradient(135deg,#8a2be2,#9966cc)';
        });
    </script>
</body>
</html>
