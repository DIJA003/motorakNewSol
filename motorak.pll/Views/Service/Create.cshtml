@using Motorak.BLL.ModelVM.Service
@using Motorak.DAL.Enums.SeviceEnums
@model CreateServiceVM
@{
    ViewData["Title"] = "Create New Service";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    * {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
        background: linear-gradient(135deg, #0a0a0f 0%, #1a0d2e 25%, #2d1b69 50%, #1a0d2e 75%, #0a0a0f 100%);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(ellipse at top left, rgba(139, 92, 246, 0.15) 0%, transparent 50%), radial-gradient(ellipse at top right, rgba(168, 85, 247, 0.12) 0%, transparent 50%), radial-gradient(ellipse at bottom left, rgba(124, 58, 237, 0.18) 0%, transparent 50%), radial-gradient(ellipse at bottom right, rgba(139, 92, 246, 0.1) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: linear-gradient(rgba(139, 92, 246, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            pointer-events: none;
            z-index: -1;
            opacity: 0.3;
        }

    .container {
        position: relative;
        z-index: 1;
        max-width: 800px;
    }

    .page-header {
        text-align: center;
        padding: 3rem 0 2rem 0;
        margin-bottom: 2rem;
    }

    .page-title {
        font-weight: 900;
        font-size: 3.5rem;
        background: linear-gradient(135deg, #ffffff 0%, #e0e7ff 30%, #c7d2fe 60%, #a78bfa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        letter-spacing: -2px;
        text-shadow: 0 0 60px rgba(139, 92, 246, 0.3);
        position: relative;
    }

        .page-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 4px;
            background: linear-gradient(90deg, #8b5cf6, #7c3aed, #a855f7, #c084fc);
            border-radius: 2px;
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.5);
        }

    .page-subtitle {
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.2rem;
        font-weight: 300;
        letter-spacing: 0.5px;
        margin-top: 1.5rem;
    }

    .form-container {
        background: rgba(15, 15, 35, 0.9);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 32px;
        padding: 3rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 32px 64px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 0 1px rgba(139, 92, 246, 0.1);
        margin-bottom: 2rem;
    }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.8), rgba(124, 58, 237, 0.8), rgba(168, 85, 247, 0.8), transparent );
        }

    .form-group {
        margin-bottom: 2rem;
        position: relative;
    }

    .form-label {
        font-weight: 700;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.9);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .form-label i {
            color: #8b5cf6;
            font-size: 1.1rem;
            text-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
        }

    .form-control,
    .form-select {
        background: rgba(0, 0, 0, 0.3);
        border: 2px solid rgba(139, 92, 246, 0.3);
        border-radius: 16px;
        padding: 1rem 1.5rem;
        color: white;
        font-weight: 500;
        font-size: 1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
        box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.2);
    }

        .form-control:focus,
        .form-select:focus {
            background: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.8);
            box-shadow: 0 0 0 0.2rem rgba(139, 92, 246, 0.25), 0 8px 25px rgba(139, 92, 246, 0.3), inset 0 2px 10px rgba(0, 0, 0, 0.2);
            color: white;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.4);
            font-weight: 400;
        }

    .form-select {
        cursor: pointer;
    }

        .form-select option {
            background: #1a0d2e;
            color: white;
            padding: 0.5rem;
            font-weight: 500;
        }

    .input-icon {
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(139, 92, 246, 0.6);
        font-size: 1.2rem;
        pointer-events: none;
        margin-top: 1.2rem;
    }

    .text-danger {
        color: #fca5a5 !important;
        font-weight: 600;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .text-danger::before {
            content: '\f071';
            font-family: 'bootstrap-icons';
            color: #ef4444;
        }

    .alert-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(185, 28, 28, 0.15) 100%);
        border: 1px solid rgba(239, 68, 68, 0.4);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        color: #fca5a5;
        font-weight: 600;
        margin-bottom: 2rem;
        box-shadow: 0 10px 25px rgba(239, 68, 68, 0.2);
        backdrop-filter: blur(10px);
    }

        .alert-danger ul {
            margin: 0;
            padding-left: 1.5rem;
        }

        .alert-danger li {
            margin-bottom: 0.5rem;
            position: relative;
        }

            .alert-danger li::marker {
                color: #ef4444;
            }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(139, 92, 246, 0.2);
    }

    .btn-create {
        background: linear-gradient(135deg, #10b981 0%, #047857 100%);
        border: none;
        border-radius: 20px;
        padding: 1rem 2.5rem;
        font-weight: 800;
        color: white;
        transition: all 0.4s ease;
        box-shadow: 0 12px 24px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.95rem;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
    }

        .btn-create::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-create:hover::before {
            left: 100%;
        }

        .btn-create:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 18px 36px rgba(16, 185, 129, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2);
            color: white;
            border-color: rgba(16, 185, 129, 0.5);
        }

        .btn-create i {
            font-size: 1.1rem;
            filter: drop-shadow(0 0 8px currentColor);
        }

    .btn-cancel {
        background: linear-gradient(135deg, #6b7280 0%, #374151 100%);
        border: none;
        border-radius: 20px;
        padding: 1rem 2.5rem;
        font-weight: 700;
        color: white;
        transition: all 0.4s ease;
        box-shadow: 0 8px 20px rgba(107, 114, 128, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.95rem;
        position: relative;
        overflow: hidden;
        border: 2px solid transparent;
    }

        .btn-cancel::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.5s ease;
        }

        .btn-cancel:hover::before {
            left: 100%;
        }

        .btn-cancel:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 28px rgba(107, 114, 128, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            color: white;
            border-color: rgba(107, 114, 128, 0.5);
        }

        .btn-cancel i {
            font-size: 1.1rem;
        }

    .floating-label {
        position: relative;
    }

        .floating-label .form-control:focus + .form-label,
        .floating-label .form-control:not(:placeholder-shown) + .form-label {
            transform: translateY(-25px) scale(0.8);
            color: #8b5cf6;
        }

    .form-section {
        background: rgba(139, 92, 246, 0.05);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        position: relative;
    }

        .form-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, #8b5cf6, #7c3aed, #a855f7);
            border-radius: 20px 20px 0 0;
        }

    .section-title {
        color: white;
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .section-title i {
            color: #8b5cf6;
            font-size: 1.4rem;
            text-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
        }
</style>

<div class="container mt-4">
    <div class="page-header">
        <h1 class="page-title">Create New Service</h1>
        <p class="page-subtitle">Add a new service to your management system</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <h6 class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please fix the following errors:</h6>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="form-container">
        <form asp-action="Create" method="post" novalidate>

            <div class="form-section">
                <div class="section-title">
                    <i class="bi bi-calendar-event"></i>
                    Service Details
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="RequestDate" class="form-label">
                                <i class="bi bi-calendar-date"></i>
                                Request Date
                            </label>
                            <input asp-for="RequestDate" class="form-control" type="date" />
                            <span asp-validation-for="RequestDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ServiceType" class="form-label">
                                <i class="bi bi-tools"></i>
                                Service Type
                            </label>
                            <select asp-for="ServiceType" class="form-select" asp-items="Html.GetEnumSelectList<ServiceType>()">
                                <option value="">-- Select Service Type --</option>
                            </select>
                            <span asp-validation-for="ServiceType" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label">
                        <i class="bi bi-flag"></i>
                        Service Status
                    </label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Status>()">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="section-title">
                    <i class="bi bi-people"></i>
                    Assignment Details
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="MechanicId" class="form-label">
                                <i class="bi bi-person-gear"></i>
                                Mechanic ID
                            </label>
                            <input asp-for="MechanicId" class="form-control" type="number" placeholder="Enter mechanic ID" />
                            <span asp-validation-for="MechanicId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CarId" class="form-label">
                                <i class="bi bi-car-front"></i>
                                Car ID
                            </label>
                            <input asp-for="CarId" class="form-control" type="number" placeholder="Enter car ID" />
                            <span asp-validation-for="CarId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-create">
                    <i class="bi bi-check-circle-fill"></i>
                    Create Service
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const formContainer = document.querySelector('.form-container');
            formContainer.style.opacity = '0';
            formContainer.style.transform = 'translateY(30px)';

            setTimeout(() => {
                formContainer.style.transition = 'all 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
                formContainer.style.opacity = '1';
                formContainer.style.transform = 'translateY(0)';
            }, 200);

            const inputs = document.querySelectorAll('.form-control, .form-select');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'scale(1.01)';
                });

                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'scale(1)';
                });
            });
        });
    </script>
}