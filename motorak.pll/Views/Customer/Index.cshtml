@using Motorak.BLL.ModelVM.Customer
@model List<CustomerListModel>
@{
    Layout = null;  
}
<style>
    body {
        background-color: #1a001f;
        color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #e0c3ff;
    }

    .card-purple {
        background-color: #2a0044;
        border: 1px solid #5a00a3;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(90, 0, 163, 0.4);
        padding: 20px;
        margin-bottom: 20px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card-purple:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(90, 0, 163, 0.6);
    }

    .card-header {
        font-size: 1.2rem;
        font-weight: bold;
        color: #fff;
        margin-bottom: 15px;
    }

    .btn-icon {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: transform 0.1s ease;
    }

    .btn-icon:hover {
        transform: scale(1.2);
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    thead th {
        background-color: #4b007d;
        border-radius: 10px;
        padding: 10px;
    }

    tbody tr {
        background-color: #35005c;
        border-radius: 10px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    tbody tr:hover {
        background-color: #5a00a3;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(90, 0, 163, 0.5);
    }

    td {
        padding: 10px;
        text-align: center;
    }

    .top-actions {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 15px;
    }

    .top-actions a {
        color: #fff;
        text-decoration: none;
        font-weight: bold;
        background-color: #4b007d;
        padding: 8px 15px;
        border-radius: 8px;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .top-actions a:hover {
        background-color: #5a00a3;
        transform: translateY(-2px);
    }
</style>

<h1>All Customers Data</h1>

<div class="top-actions">
    <a asp-controller="Customer" asp-action="Create">
        Add New Customer
    </a>
</div>

@foreach (var customer in Model.Where(m => !m.IsDeleted))
{
    <div class="card-purple">
        <div class="card-header">
            @customer.Name
        </div>
        <table>
            <tr>
                <td><strong>Email:</strong> @customer.Email</td>
                <td><strong>Purchased Cars:</strong> @customer.PurchasedCarsCount</td>
                <td><strong>Created At:</strong> @customer.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td><strong>Deleted:</strong> @customer.IsDeleted</td>
                <td><strong>Updated:</strong> @customer.IsUpdated</td>
                <td>
                    <a asp-controller="Customer" asp-action="Edit" asp-route-id="@customer.Id" class="btn-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                        </svg>
                    </a>
                </td>
                <td>
                    <form asp-controller="Customer" asp-action="Delete" method="post" style="display:inline;" onsubmit="return confirmDelete();">
                        <input type="hidden" name="id" value="@customer.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="red" class="bi bi-trash3" viewBox="0 0 16 16">
                                <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5"/>
                            </svg>
                        </button>
                    </form>
                </td>
            </tr>
        </table>
    </div>
}

<script>
    function confirmDelete() {
        return confirm("Are you sure you want to delete this customer?");
    }
</script>

