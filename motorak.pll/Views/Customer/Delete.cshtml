@using Motorak.BLL.ModelVM.Customer
@model CustomerDetailsModel

<style>
    /* Custom card style for this view only */
    .card-purple {
        background-color: #2a0044; /* deep purple for card body */
        color: white;
        border: 1px solid #5a00a3; /* purple border */
        border-radius: 15px;
        box-shadow: 0 4px 10px rgba(90, 0, 163, 0.5);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-purple:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(90, 0, 163, 0.7);
        }

        .card-purple .card-header {
            background-color: #4b007d;
            border-bottom: 1px solid #5a00a3;
            font-weight: bold;
        }

        .card-purple .card-body {
            background-color: #35005c;
        }
</style>

<div class="card">
	<h5 class="card-header">Delete</h5>
	<div class="card-body">
        <form asp-controller="Customer" asp-action="Delete">
                <input type="hidden" asp-for="Id">
			<p class="card-text">Are You Sure You Want To Delete</p><a asp-controller="Home" asp-action="Index" class="btn btn-dark">Back</a>
			<a asp-controller="Customer" asp-action="DeleteEmployee" asp-route-id="@Model.Id" type="button" class="btn btn-danger">Delete</a>
		</form>
	</div>
</div>
